# ═══════════════════════════════════════════════════════════════
# SHIFAA – .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Maven build output ───────────────────────────────────────────
target/
out/
build/
dist/

# ── Compiled Java classes ────────────────────────────────────────
*.class
*.jar
*.war
*.ear

# ── SENSITIVE – credentials & secrets ───────────────────────────
src/main/resources/email.properties

# ── Runtime-generated files (created automatically at startup) ──
qrcodes/
events_images/
*.log
logs/

# ── IntelliJ IDEA ────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/

# ── Eclipse ──────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ── NetBeans ──────────────────────────────────────────────────────
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ── VS Code ───────────────────────────────────────────────────────
.vscode/

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
