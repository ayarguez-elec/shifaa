<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.PharmacyAddStockController"
            styleClass="app-root"
            style="-fx-background-color: #F8FAFC;">

    <left>
        <VBox prefWidth="260.0" spacing="25.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="45" right="18" bottom="25" left="18"/>
            </padding>

            <children>
                <Label text="SHIFAA PHARMACIE" styleClass="admin-logo"/>

                <Button text="Mon stock"
                        styleClass="admin-menu-button-active"
                        onAction="#goStock"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="24.0"
              styleClass="page-content"
              style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets top="42" right="70" bottom="45" left="55"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label fx:id="pageTitleLabel"
                                       text="Ajouter stock"
                                       styleClass="admin-page-title"/>

                                <Label fx:id="pageSubtitleLabel"
                                       text="Choisissez la pharmacie, le produit, la quantite disponible et le statut."
                                       styleClass="admin-subtitle"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Retour stock"
                                prefWidth="160.0"
                                prefHeight="46.0"
                                styleClass="dark-button"
                                onAction="#goBackStock"/>
                    </children>
                </HBox>

                <VBox spacing="22.0"
                      maxWidth="930.0"
                      style="-fx-background-color: #FFFFFF;
                             -fx-background-radius: 18;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 18;
                             -fx-padding: 28;
                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.07), 18, 0, 0, 5);">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Informations du stock"
                                       style="-fx-text-fill: #0F172A;
                                              -fx-font-size: 18px;
                                              -fx-font-weight: bold;"/>

                                <Label text="Les valeurs seront enregistrees directement dans la table product."
                                       styleClass="admin-subtitle"/>
                            </children>
                        </VBox>

                        <HBox spacing="18.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Pharmacie"
                                               style="-fx-text-fill: #0F172A;
                                                      -fx-font-size: 13px;
                                                      -fx-font-weight: bold;"/>

                                        <ComboBox fx:id="pharmacyCombo"
                                                  promptText="Choisir une pharmacie"
                                                  maxWidth="Infinity"
                                                  prefHeight="48.0"
                                                  style="-fx-background-color: #FFFFFF;
                                                         -fx-border-color: #DBE4EF;
                                                         -fx-border-radius: 13;
                                                         -fx-background-radius: 13;
                                                         -fx-padding: 6;
                                                         -fx-font-size: 14px;
                                                         -fx-text-fill: #0F172A;"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Produit"
                                               style="-fx-text-fill: #0F172A;
                                                      -fx-font-size: 13px;
                                                      -fx-font-weight: bold;"/>

                                        <ComboBox fx:id="productCombo"
                                                  promptText="Choisir un produit"
                                                  maxWidth="Infinity"
                                                  prefHeight="48.0"
                                                  style="-fx-background-color: #FFFFFF;
                                                         -fx-border-color: #DBE4EF;
                                                         -fx-border-radius: 13;
                                                         -fx-background-radius: 13;
                                                         -fx-padding: 6;
                                                         -fx-font-size: 14px;
                                                         -fx-text-fill: #0F172A;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="18.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Quantite disponible"
                                               style="-fx-text-fill: #0F172A;
                                                      -fx-font-size: 13px;
                                                      -fx-font-weight: bold;"/>

                                        <TextField fx:id="quantityField"
                                                   promptText="Ex : 30"
                                                   maxWidth="Infinity"
                                                   prefHeight="48.0"
                                                   styleClass="modern-input"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Statut disponibilite"
                                               style="-fx-text-fill: #0F172A;
                                                      -fx-font-size: 13px;
                                                      -fx-font-weight: bold;"/>

                                        <ComboBox fx:id="statusCombo"
                                                  promptText="Choisir le statut"
                                                  maxWidth="Infinity"
                                                  prefHeight="48.0"
                                                  style="-fx-background-color: #FFFFFF;
                                                         -fx-border-color: #DBE4EF;
                                                         -fx-border-radius: 13;
                                                         -fx-background-radius: 13;
                                                         -fx-padding: 6;
                                                         -fx-font-size: 14px;
                                                         -fx-text-fill: #0F172A;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="14.0">
                            <children>
                                <Button text="Annuler"
                                        prefWidth="150.0"
                                        prefHeight="48.0"
                                        styleClass="dark-button"
                                        onAction="#clearForm"/>

                                <Button fx:id="saveButton"
                                        text="Enregistrer"
                                        prefWidth="190.0"
                                        prefHeight="48.0"
                                        styleClass="primary-button"
                                        onAction="#saveStock"/>
                            </children>
                        </HBox>

                        <Label fx:id="messageLabel"
                               text=""
                               style="-fx-text-fill: #10B981;
                                      -fx-font-weight: bold;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
