<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controler.AdminProductController"
            styleClass="app-root" stylesheets="@pharmacy_style.css">

    

    <center>
        <VBox spacing="18.0"
              styleClass="page-content">

            <padding>
                <Insets top="35" right="45" bottom="30" left="45"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="20.0">

                    <children>
                        <Label text="🎁 Gestion des Produits"
                               styleClass="admin-page-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="+ Ajouter produit"
                                prefWidth="210.0"
                                prefHeight="48.0"
                                styleClass="red-large-button"
                                onAction="#goAddProduct"/>

                        <Button text="📂 Export Excel"
                                prefWidth="160.0"
                                prefHeight="48.0"
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;"
                                onAction="#exportExcel"/>

                        <Button text="📄 Export PDF"
                                prefWidth="160.0"
                                prefHeight="48.0"
                                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;"
                                onAction="#exportPdf"/>

                        <Button text="Retour"
                                prefWidth="120.0"
                                prefHeight="48.0"
                                styleClass="dark-button"
                                onAction="#goDashboard"/>
                    </children>
                </HBox>

                <TextField fx:id="searchField"
                           prefHeight="52.0"
                           maxWidth="Infinity"
                           promptText="Rechercher par nom, catégorie, laboratoire, pharmacie ou statut..."
                           styleClass="search-field"/>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="clean-scroll">

                    <content>
                        <FlowPane fx:id="productContainer"
                                  hgap="24.0"
                                  vgap="24.0"
                                  prefWrapLength="1150.0"
                                  styleClass="cards-zone"/>
                    </content>
                </ScrollPane>

                <HBox prefHeight="60.0"
                      alignment="CENTER"
                      spacing="16.0"
                      styleClass="modern-pagination-bar">

                    <children>
                        <Label fx:id="totalLabel"
                               text="Total : 0 produits"
                               styleClass="pagination-total"/>

                        <Button text="‹"
                                prefWidth="44.0"
                                prefHeight="40.0"
                                styleClass="pagination-arrow"
                                onAction="#previousPage"/>

                        <Label fx:id="pageLabel"
                               text="Page 1 / 1"
                               styleClass="pagination-page"/>

                        <Button text="›"
                                prefWidth="44.0"
                                prefHeight="40.0"
                                styleClass="pagination-arrow"
                                onAction="#nextPage"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>
