<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Line?>

<ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.ForgotPasswordController">
    <content>
        <AnchorPane prefHeight="800.0" prefWidth="1400.0" styleClass="root" stylesheets="@theme-medical.css">
            <HBox alignment="CENTER" spacing="50" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
                
                <!-- CARRE BLEU (Identique au Login) -->
                <VBox spacing="25" alignment="CENTER" style="-fx-background-color: #1a202c; -fx-background-radius: 30; -fx-padding: 60 50;" prefWidth="450">
                    <ImageView fitHeight="200" fitWidth="200" preserveRatio="true">
                        <Image url="@/heart.png" />
                    </ImageView>
                    <Label text="SHIFAA" textFill="#FF8C00" style="-fx-font-size: 36; -fx-font-weight: bold;" />
                    <Label text="Récupération de compte" textFill="#FFFFFF" style="-fx-font-size: 20;" />
                </VBox>

                <!-- FORMULAIRE MULTI-ÉTAPES -->
                <VBox spacing="25" alignment="CENTER" style="-fx-padding: 50 40; -fx-background-color: white; -fx-background-radius: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 5);" prefWidth="450">
                    
                    <Label fx:id="mainTitle" text="Mot de passe oublié ?" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
                    <Label fx:id="subTitle" text="Entrez votre email pour recevoir un code" style="-fx-font-size: 14; -fx-text-fill: #718096;" textAlignment="CENTER" wrapText="true" />

                    <StackPane>
                        <!-- ÉTAPE 1 : Saisie Email -->
                        <VBox fx:id="step1Email" spacing="15" alignment="CENTER">
                            <TextField fx:id="emailField" promptText="Votre adresse e-mail" style="-fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0;" prefWidth="350" />
                            <Button onAction="#handleSendCode" text="ENVOYER LE CODE" style="-fx-background-color: #FF5C5C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14; -fx-cursor: hand;" prefWidth="350" />
                        </VBox>

                        <!-- ÉTAPE 2 : Saisie Code (Masqué par défaut) -->
                        <VBox fx:id="step2Code" spacing="15" alignment="CENTER" visible="false">
                            <TextField fx:id="codeField" promptText="Code à 6 chiffres" style="-fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0;" prefWidth="350" />
                            <Button onAction="#handleVerifyCode" text="VÉRIFIER LE CODE" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14; -fx-cursor: hand;" prefWidth="350" />
                        </VBox>

                        <!-- ÉTAPE 3 : Nouveau Mot de Passe (Masqué par défaut) -->
                        <VBox fx:id="step3Password" spacing="15" alignment="CENTER" visible="false">
                            <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe" style="-fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0;" prefWidth="350" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe" style="-fx-padding: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E2E8F0;" prefWidth="350" />
                            <Button onAction="#handleChangePassword" text="RÉINITIALISER" style="-fx-background-color: #48BB78; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14; -fx-cursor: hand;" prefWidth="350" />
                        </VBox>
                    </StackPane>

                    <Label fx:id="errorLabel" text="" textFill="#FF5C5C" style="-fx-font-size: 12;" />

                    <Hyperlink onAction="#backToLogin" text="Retour à la connexion" style="-fx-text-fill: #718096; -fx-font-size: 13;" />
                </VBox>

            </HBox>
        </AnchorPane>
    </content>
</ScrollPane>
