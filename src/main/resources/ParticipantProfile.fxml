<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controler.ParticipantProfileController"
            stylesheets="@shifaa.css"
            prefWidth="1000" prefHeight="720">

    <!-- ═══ MAIN CONTENT ═══ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:#f0f4f0; -fx-border-color:transparent;">
            <VBox spacing="0" style="-fx-background-color:#f0f4f0;">

                <!-- ── Header ── -->
                <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
                    <Button text="← Retour" onAction="#handleRetour"
                            style="-fx-background-color:transparent; -fx-border-color:#e2e8f0;
                                   -fx-border-radius:8; -fx-background-radius:8;
                                   -fx-text-fill:#4a5568; -fx-cursor:hand; -fx-padding:6 14 6 14;"/>
                    <StackPane styleClass="page-title-icon" style="-fx-background-color:#ede9fe;">
                        <Label text="👤" style="-fx-font-size:20px;"/>
                    </StackPane>
                    <VBox spacing="3">
                        <Label text="Profil Participant" styleClass="page-title"/>
                        <Label text="Fidélité · Statistiques · Historique · Notifications"
                               styleClass="page-subtitle"/>
                    </VBox>
                </HBox>

                <HBox spacing="20" style="-fx-padding:0 28 28 28;">

                    <!-- ══ LEFT COLUMN: Profile card ══ -->
                    <VBox spacing="16" prefWidth="300" minWidth="280">

                        <!-- Profile card -->
                        <VBox spacing="12" style="-fx-background-color:white; -fx-background-radius:14;
                                                   -fx-padding:24; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                            <!-- Avatar + name -->
                            <VBox alignment="CENTER" spacing="8">
                                <Label fx:id="lblAvatar" text="?" minWidth="60" minHeight="60"
                                       style="-fx-background-color:#1e3a5f; -fx-background-radius:40;
                                              -fx-text-fill:white; -fx-font-weight:bold;
                                              -fx-font-size:22px; -fx-alignment:center;"/>
                                <Label fx:id="lblNom" text="—"
                                       style="-fx-font-size:17px; -fx-font-weight:bold; -fx-text-fill:#1a2332;"/>
                                <Label fx:id="lblEmail" text="—"
                                       style="-fx-font-size:12px; -fx-text-fill:#718096;"/>
                                <Label fx:id="lblTel" text="—"
                                       style="-fx-font-size:12px; -fx-text-fill:#718096;"/>
                            </VBox>

                            <Separator/>

                            <!-- Badge + Priority -->
                            <VBox spacing="6">
                                <Label text="BADGE" style="-fx-font-size:10px; -fx-text-fill:#a0aec0; -fx-font-weight:bold;"/>
                                <Label fx:id="lblBadge" text="🥉 Bronze"
                                       style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#b45309;"/>

                                <Label text="PRIORITÉ" style="-fx-font-size:10px; -fx-text-fill:#a0aec0; -fx-font-weight:bold;"/>
                                <Label fx:id="lblPriority" text="▫ LOW"
                                       style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#6b7280;"/>
                            </VBox>

                            <Separator/>

                            <!-- Score + Progress -->
                            <VBox spacing="6">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="🏅 Score fidélité"
                                           style="-fx-font-size:12px; -fx-text-fill:#4a5568; -fx-font-weight:bold;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblScore" text="0 pts"
                                           style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1e3a5f;"/>
                                </HBox>
                                <ProgressBar fx:id="pbScore" progress="0" maxWidth="Infinity"
                                             style="-fx-accent:#b45309;" prefHeight="8"/>
                                <Label fx:id="lblProchainBadge" text="— pts pour Silver"
                                       style="-fx-font-size:11px; -fx-text-fill:#718096; -fx-font-style:italic;"/>
                            </VBox>
                        </VBox>

                        <!-- Stats card -->
                        <VBox spacing="10" style="-fx-background-color:white; -fx-background-radius:14;
                                                   -fx-padding:20; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                            <Label text="📊 Statistiques" style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1a2332;"/>
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints minWidth="60" halignment="RIGHT"/>
                                </columnConstraints>

                                <Label text="Total réservations"     style="-fx-text-fill:#4a5568; -fx-font-size:12px;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="lblTotalResa" text="0" style="-fx-font-weight:bold; -fx-text-fill:#1a2332;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Confirmées"             style="-fx-text-fill:#16a34a; -fx-font-size:12px;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="lblConfirme"  text="0" style="-fx-font-weight:bold; -fx-text-fill:#16a34a;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Annulées"               style="-fx-text-fill:#c53030; -fx-font-size:12px;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="lblAnnule"    text="0" style="-fx-font-weight:bold; -fx-text-fill:#c53030;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                                <Label text="Présences réelles"      style="-fx-text-fill:#1d4ed8; -fx-font-size:12px;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <Label fx:id="lblPresence"  text="0" style="-fx-font-weight:bold; -fx-text-fill:#1d4ed8;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                                <Label text="Taux de présence"       style="-fx-text-fill:#7c3aed; -fx-font-size:12px;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <Label fx:id="lblTauxPresence" text="0%" style="-fx-font-weight:bold; -fx-text-fill:#7c3aed;" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                            </GridPane>
                        </VBox>
                    </VBox>

                    <!-- ══ RIGHT COLUMN: Réservations + Notifications ══ -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS">

                        <!-- Reservation history -->
                        <VBox spacing="10" style="-fx-background-color:white; -fx-background-radius:14;
                                                   -fx-padding:20; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                            <Label text="📋 Historique des réservations"
                                   style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1a2332;"/>
                            <ScrollPane fitToWidth="true" prefHeight="280"
                                        style="-fx-background-color:transparent; -fx-border-color:transparent;">
                                <VBox fx:id="reservationsPane" spacing="8"
                                      style="-fx-background-color:transparent;"/>
                            </ScrollPane>
                        </VBox>

                        <!-- Notifications history -->
                        <VBox spacing="10" style="-fx-background-color:white; -fx-background-radius:14;
                                                   -fx-padding:20; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                            <Label text="🔔 Notifications reçues"
                                   style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#1a2332;"/>
                            <ScrollPane fitToWidth="true" prefHeight="200"
                                        style="-fx-background-color:transparent; -fx-border-color:transparent;">
                                <VBox fx:id="notificationsPane" spacing="8"
                                      style="-fx-background-color:transparent;"/>
                            </ScrollPane>
                        </VBox>
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
