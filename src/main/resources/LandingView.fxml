<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane fx:id="scrollPane" fitToWidth="true" stylesheets="@theme-medical.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.LandingController">
    <VBox>
        <!-- 1. SECTION HERO -->
        <StackPane prefHeight="800.0" styleClass="landing-bg">
            <VBox alignment="TOP_CENTER" spacing="40" styleClass="landing-overlay">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30 50;">
                    <Label text="SHIFAA" style="-fx-text-fill: white; -fx-font-size: 32; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="20">
                        <Button onAction="#scrollToServices" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-font-weight: bold;" text="Nos Services" />
                        <Button onAction="#scrollToContact" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15; -fx-cursor: hand; -fx-font-weight: bold;" text="Nous Contacter" />
                        <Label text="|" style="-fx-text-fill: white; -fx-font-size: 15;" />
                        <Button onAction="#goToLogin" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 8; -fx-text-fill: white; -fx-padding: 10 25; -fx-font-size: 15; -fx-cursor: hand; -fx-font-weight: bold;" text="Connexion" />
                        <Button onAction="#goToSignUp" style="-fx-background-color: #FF5C5C; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 25; -fx-font-size: 15; -fx-cursor: hand; -fx-font-weight: bold;" text="S'inscrire" />
                    </HBox>
                </HBox>
                
                <Region VBox.vgrow="ALWAYS" />

                <!-- Center Text & Buttons -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20 20;">
                    <Label text="Il est temps de prendre" style="-fx-text-fill: white; -fx-font-size: 70; -fx-font-weight: bold;" />
                    <Label text="votre santé en main." style="-fx-text-fill: white; -fx-font-size: 70; -fx-font-style: italic; -fx-font-weight: bold;" />
                    
                    <Label text="Vos dossiers médicaux et les meilleurs professionnels&#10;de santé, réunis au même endroit." textAlignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 22; -fx-line-spacing: 5;" />
                    
                    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 40 0 0 0;">
                        <Button onAction="#goToSignUp" styleClass="btn-hero-primary" text="Rejoindre Shifaa" />
                        <Button onAction="#goToLogin" styleClass="btn-hero-secondary" text="J'ai déjà un compte" />
                    </HBox>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
            </VBox>
        </StackPane>

        <!-- 2. SECTION SERVICES -->
        <VBox fx:id="servicesSection" alignment="CENTER" spacing="40" styleClass="services-section">
            <VBox alignment="CENTER" spacing="10">
                <Label text="Nos Services" styleClass="section-title" />
                <Label text="Une plateforme complète pour votre santé et votre bien-être" styleClass="section-subtitle" />
            </VBox>
            
            <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20 50;">
                <!-- Card 1 -->
                <VBox styleClass="service-card" spacing="15" alignment="CENTER">
                    <Label text="🗓️" style="-fx-font-size: 40;" />
                    <Label text="Smart Booking" styleClass="service-title" />
                    <Label text="Prenez RDV facilement en cabinet ou téléconsultation avec rappels." textAlignment="CENTER" wrapText="true" styleClass="service-desc" />
                </VBox>
                
                <!-- Card 2 -->
                <VBox styleClass="service-card" spacing="15" alignment="CENTER">
                    <Label text="📁" style="-fx-font-size: 40;" />
                    <Label text="Dossier Numérique" styleClass="service-title" />
                    <Label text="Centralisez vos ordonnances et historiques médicaux en toute sécurité." textAlignment="CENTER" wrapText="true" styleClass="service-desc" />
                </VBox>

                <!-- Card 3 -->
                <VBox styleClass="service-card" spacing="15" alignment="CENTER">
                    <Label text="💊" style="-fx-font-size: 40;" />
                    <Label text="E-Pharmacie" styleClass="service-title" />
                    <Label text="Vérifiez les stocks et ne ratez aucune prise grâce à notre tracker intelligent." textAlignment="CENTER" wrapText="true" styleClass="service-desc" />
                </VBox>

                <!-- Card 4 -->
                <VBox styleClass="service-card" spacing="15" alignment="CENTER">
                    <Label text="🤖" style="-fx-font-size: 40;" />
                    <Label text="Assistant IA" styleClass="service-title" />
                    <Label text="Posez vos questions de santé 24/7 et connectez-vous par reconnaissance faciale." textAlignment="CENTER" wrapText="true" styleClass="service-desc" />
                </VBox>
            </HBox>
        </VBox>

        <!-- 3. SECTION CONTACT -->
        <HBox fx:id="contactSection" alignment="CENTER" styleClass="contact-section" spacing="50">
            <!-- Left: Info -->
            <VBox spacing="20" prefWidth="400">
                <Label text="Nous Contacter" styleClass="section-title-light" />
                <Label text="Notre équipe est à votre disposition pour vous accompagner." wrapText="true" styleClass="contact-desc" />
                
                <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="📍" style="-fx-font-size: 20;" />
                        <Label text="Pôle Technologique, Tunis, Tunisie" styleClass="contact-info" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="📞" style="-fx-font-size: 20;" />
                        <Label text="+216 71 123 456" styleClass="contact-info" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="📧" style="-fx-font-size: 20;" />
                        <Label text="support@shifaa.tn" styleClass="contact-info" />
                    </HBox>
                </VBox>
            </VBox>
            
            <!-- Right: Form -->
            <VBox spacing="15" styleClass="contact-form" prefWidth="500">
                <Label text="Envoyez-nous un message" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2d3748;" />
                <TextField fx:id="contactName" promptText="Nom Complet" styleClass="text-field, contact-input" />
                <TextField fx:id="contactEmail" promptText="Adresse Email" styleClass="text-field, contact-input" />
                <TextField fx:id="contactSubject" promptText="Sujet" styleClass="text-field, contact-input" />
                <TextArea fx:id="contactMessage" promptText="Votre message..." prefRowCount="5" styleClass="text-area, contact-input" wrapText="true" />
                <Button text="Envoyer le message" onAction="#handleContactSubmit" styleClass="btn-primary, btn-submit" maxWidth="Infinity" />
                <Label fx:id="contactStatusLabel" text="" style="-fx-text-fill: #38A169; -fx-font-weight: bold;" visible="false"/>
            </VBox>
        </HBox>
        
        <!-- Footer simple -->
        <HBox alignment="CENTER" style="-fx-background-color: #1A202C; -fx-padding: 20;">
            <Label text="© 2026 Shifaa - Tous droits réservés." style="-fx-text-fill: #A0AEC0; -fx-font-size: 13;" />
        </HBox>
        
    </VBox>
</ScrollPane>
