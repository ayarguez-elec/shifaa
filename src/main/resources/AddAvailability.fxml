<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            styleClass="root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controler.AddAvailability">
    <children>
        <!-- Sidebar -->
        <AnchorPane prefHeight="650.0" prefWidth="220.0" styleClass="sidebar">
            <children>
                <Label layoutX="30.0" layoutY="40.0" text="SHIFAA" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Button layoutY="120.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button" text="Tableau de bord"/>
                <Button layoutY="170.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button" text="Rendez-vous"/>
                <Button layoutY="220.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button-active" text="Disponibilités"/>
            </children>
        </AnchorPane>

        <Label layoutX="260.0" layoutY="30.0"
               style="-fx-font-size: 22; -fx-font-weight: bold;"
               text="Ajouter une Disponibilité" textFill="#2d3748"/>

        <!-- Médecin -->
        <Label layoutX="260.0" layoutY="90.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Médecin"/>
        <Label layoutX="260.0" layoutY="118.0" text="ID Médecin :"/>
        <TextField fx:id="doctorId" layoutX="260.0" layoutY="138.0" prefWidth="200.0"/>

        <!-- Créneau -->
        <Label layoutX="260.0" layoutY="195.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Créneau"/>

        <Label layoutX="260.0" layoutY="223.0" text="Date :"/>
        <DatePicker fx:id="date" layoutX="260.0" layoutY="243.0" prefWidth="200.0"/>

        <Label layoutX="490.0" layoutY="223.0" text="Heure :"/>
        <TextField fx:id="time" layoutX="490.0" layoutY="243.0"
                   prefWidth="200.0" promptText="HH:mm:ss"/>

        <!-- Statut -->
        <Label layoutX="260.0" layoutY="305.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Statut"/>
        <Label layoutX="260.0" layoutY="333.0" text="statusRDV :"/>
        <ComboBox fx:id="statusRDV" layoutX="260.0" layoutY="353.0" prefWidth="200.0"/>

        <Label fx:id="messageLabel" layoutX="260.0" layoutY="430.0"
               style="-fx-text-fill: #38A169;"/>

        <Button layoutX="690.0" layoutY="590.0"
                prefHeight="40.0" prefWidth="140.0"
                styleClass="btn-primary" text="Ajouter"
                onAction="#ajouterDisponibilite"/>
        <Button layoutX="845.0" layoutY="590.0"
                prefHeight="40.0" prefWidth="100.0"
                style="-fx-background-color: #A0AEC0; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                text="Annuler" onAction="#annuler"/>
    </children>
</AnchorPane>