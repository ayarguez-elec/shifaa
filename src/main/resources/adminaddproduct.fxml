<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminAddProductController"
            styleClass="app-root">

    <left>
        <VBox prefWidth="260.0" spacing="25.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="45" right="18" bottom="25" left="18"/>
            </padding>

            <children>
                <Label text="💊 SHIFAA ADMIN" styleClass="admin-logo"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="28.0" styleClass="page-content">
            <padding>
                <Insets top="42" right="70" bottom="45" left="70"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT" spacing="18.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Ajouter un Produit"
                                       styleClass="admin-page-title"/>

                                <Label text="Créer une fiche médicament."
                                       styleClass="admin-subtitle"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="← Retour"
                                prefWidth="120.0"
                                prefHeight="42.0"
                                styleClass="dark-button"
                                onAction="#goBackProducts"/>
                    </children>
                </HBox>

                <HBox spacing="34.0" alignment="TOP_LEFT">
                    <children>

                        <VBox spacing="16.0"
                              prefWidth="300.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 18;
                                     -fx-padding: 22;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0, 0, 4);">

                            <children>
                                <Label text="Image du produit"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #0F172A;"/>

                                <VBox alignment="CENTER"
                                      prefHeight="160.0"
                                      style="-fx-background-color: #EFF6FF;
                                             -fx-background-radius: 16;
                                             -fx-border-color: #DBEAFE;
                                             -fx-border-radius: 16;">

                                    <children>
                                        <ImageView fx:id="imagePreview"
                                                   fitWidth="230.0"
                                                   fitHeight="135.0"
                                                   preserveRatio="true"/>
                                    </children>
                                </VBox>

                                <Button text="📷 Choisir une image"
                                        prefWidth="220.0"
                                        prefHeight="42.0"
                                        styleClass="dark-button"
                                        onAction="#chooseImage"/>

                                <Button text="Supprimer image"
                                        prefWidth="180.0"
                                        prefHeight="38.0"
                                        style="-fx-background-color: #FEE2E2;
                                               -fx-text-fill: #B91C1C;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10;"
                                        onAction="#removeImage"/>

                                <Label fx:id="imageLabel"
                                       text="Aucune image sélectionnée"
                                       wrapText="true"
                                       style="-fx-text-fill: #64748B;
                                              -fx-font-size: 13px;"/>
                            </children>
                        </VBox>

                        <VBox spacing="18.0" prefWidth="720.0">
                            <children>

                                <Label text="Informations du produit"
                                       style="-fx-font-size: 20px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #0F172A;"/>

                                <GridPane hgap="18.0" vgap="16.0">

                                    <children>
                                        <VBox spacing="8.0"
                                              GridPane.rowIndex="0"
                                              GridPane.columnIndex="0">
                                            <children>
                                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <TextField fx:id="nameField"
                                                                   promptText="Nom produit *"
                                                                   prefHeight="44.0"
                                                                   prefWidth="205.0"
                                                                   styleClass="modern-input"/>

                                                        <Button text="Verifier"
                                                                prefHeight="44.0"
                                                                prefWidth="115.0"
                                                                styleClass="dark-button"
                                                                onAction="#verifyDrug"/>
                                                    </children>
                                                </HBox>

                                                <ComboBox fx:id="rxNormResults"
                                                          promptText="Resultats RxNorm"
                                                          prefHeight="44.0"
                                                          prefWidth="330.0"
                                                          visibleRowCount="6"
                                                          styleClass="modern-input"/>
                                            </children>
                                        </VBox>

                                        <TextField fx:id="descriptionField"
                                                   promptText="Description"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="0"
                                                   GridPane.columnIndex="1"
                                                   styleClass="modern-input"/>

                                        <TextField fx:id="dosageField"
                                                   promptText="Dosage ex: 500mg"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="0"
                                                   styleClass="modern-input"/>

                                        <TextField fx:id="formField"
                                                   promptText="Forme ex: comprimé"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="1"
                                                   styleClass="modern-input"/>

                                        <TextField fx:id="laboratoryField"
                                                   promptText="Laboratoire"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="2"
                                                   GridPane.columnIndex="0"
                                                   styleClass="modern-input"/>

                                        <TextField fx:id="therapeuticClassField"
                                                   promptText="Classe thérapeutique"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="2"
                                                   GridPane.columnIndex="1"
                                                   styleClass="modern-input"/>

                                        <TextField fx:id="priceField"
                                                   promptText="Prix * ex: 4.500"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="3"
                                                   GridPane.columnIndex="0"
                                                   styleClass="modern-input"/>

                                        <TextField fx:id="categoryField"
                                                   promptText="Catégorie"
                                                   prefHeight="44.0"
                                                   prefWidth="330.0"
                                                   GridPane.rowIndex="3"
                                                   GridPane.columnIndex="1"
                                                   styleClass="modern-input"/>
                                    </children>
                                </GridPane>

                                <Button text="Enregistrer le produit"
                                        prefWidth="210.0"
                                        prefHeight="48.0"
                                        style="-fx-background-color: #fb5a64;
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10;
                                               -fx-cursor: hand;"
                                        onAction="#saveProduct"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
