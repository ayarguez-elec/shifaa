<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="Controler.SignUpController" stylesheets="@shifaa.css" styleClass="auth-root" prefWidth="900" prefHeight="600">
    
    <!-- Left Pane (Dark with Logo) -->
    <VBox styleClass="auth-left-pane" HBox.hgrow="ALWAYS" spacing="20" maxWidth="450" alignment="CENTER">
        <ImageView fitWidth="180" preserveRatio="true" styleClass="auth-logo">
            <image>
                <Image url="@images/logo.png"/>
            </image>
        </ImageView>
        <Label text="SHIFAA" styleClass="auth-title" style="-fx-text-fill: #ffffff;"/>
        <Label text="Inscription" style="-fx-font-size: 18px; -fx-text-fill: rgba(255,255,255,0.7);"/>
    </VBox>

    <!-- Right Pane (White with Form) -->
    <VBox styleClass="auth-right-pane" HBox.hgrow="ALWAYS" alignment="CENTER">
        <VBox maxWidth="350" spacing="15" alignment="CENTER">
            
            <VBox alignment="CENTER" spacing="5">
                <Label text="Créer un compte" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
                <Label text="Rejoignez-nous aujourd'hui" style="-fx-text-fill: #718096;"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER">
                <ImageView fx:id="imgProfile" fitWidth="60" fitHeight="60" styleClass="profile-avatar">
                    <image>
                        <Image url="@images/default_profile.png"/>
                    </image>
                </ImageView>
                <Button text="Choisir Photo" onAction="#handleChoosePhoto" styleClass="btn, btn-outline, btn-sm"/>
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="tfNom" promptText="Nom" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="tfPrenom" promptText="Prénom" styleClass="form-field" HBox.hgrow="ALWAYS"/>
            </HBox>

            <TextField fx:id="tfEmail" promptText="Email" styleClass="form-field"/>
            <PasswordField fx:id="tfPassword" promptText="Mot de passe" styleClass="form-field"/>
            <PasswordField fx:id="tfConfirmPassword" promptText="Confirmer le mot de passe" styleClass="form-field"/>
            
            <ComboBox fx:id="cbRole" maxWidth="Infinity" styleClass="form-combo" promptText="Sélectionner un rôle"/>

            <VBox spacing="10" alignment="CENTER">
                <Button text="S'INSCRIRE" onAction="#handleSignUp" maxWidth="Infinity" styleClass="btn, btn-primary, btn-lg" style="-fx-background-color: #f86060; -fx-text-fill: white; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Button>
                
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Vous avez déjà un compte ?" style="-fx-text-fill: #718096;"/>
                    <Hyperlink text="Se connecter" onAction="#handleGoToLogin" style="-fx-text-fill: #f86060; -fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="lblMessage" text="" style="-fx-font-weight: bold;"/>
            </VBox>

        </VBox>
    </VBox>
</HBox>
