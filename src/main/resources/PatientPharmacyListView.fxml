<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="950.0" prefHeight="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.PatientPharmacyListController">

    <VBox spacing="15" style="-fx-padding: 20;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="💊 Pharmacies" textFill="#2d3748" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- Filtres -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Nom / Pharmacie :" style="-fx-font-size: 12;" />
            <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="250" style="-fx-padding: 6; -fx-font-size: 12;" />
            <Label text="Ville :" style="-fx-font-size: 12;" />
            <ComboBox fx:id="locationFilter" prefWidth="150" style="-fx-font-size: 12;" />
            <Button onAction="#resetFilters" style="-fx-background-color: #718096; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 4 10; -fx-cursor: hand; -fx-font-size: 11;" text="Réinitialiser" />
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20" />
            </content>
        </ScrollPane>

        <Label fx:id="statusLabel" style="-fx-text-fill: #718096;" text="Total: 0 pharmacies" />

        <HBox fx:id="paginationBox" alignment="CENTER" spacing="5" />
    </VBox>
</AnchorPane>