<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminPharmacyController"
            styleClass="app-root">

    <left>
        <VBox prefWidth="260.0"
              spacing="25.0"
              styleClass="admin-sidebar">

            <padding>
                <Insets top="45" right="18" bottom="25" left="18"/>
            </padding>

            <children>
                <Label text="💊 SHIFAA ADMIN"
                       styleClass="admin-logo"/>

                <Button text="Accueil"
                        styleClass="admin-menu-button"
                        onAction="#goDashboard"/>

                <Button text="Produits"
                        styleClass="admin-menu-button"
                        onAction="#goProducts"/>

                <Button text="Pharmacies"
                        styleClass="admin-menu-button-active"
                        onAction="#goPharmacies"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="22.0"
              styleClass="page-content">

            <padding>
                <Insets top="45" right="45" bottom="35" left="45"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="20.0">

                    <children>
                        <Label text="🛡 Gestion des Pharmacies"
                               styleClass="admin-page-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="+ Ajouter pharmacie"
                                prefWidth="220.0"
                                prefHeight="50.0"
                                styleClass="red-large-button"
                                onAction="#goAddPharmacy"/>

                        <Button text=" Retour"
                                prefWidth="150.0"
                                prefHeight="50.0"
                                styleClass="dark-button"
                                onAction="#goDashboard"/>
                    </children>
                </HBox>

                <TextField fx:id="searchField"
                           maxWidth="Infinity"
                           prefHeight="52.0"
                           promptText="Rechercher par nom, adresse, téléphone, email ou statut..."
                           styleClass="search-field"/>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="clean-scroll">

                    <content>
                        <FlowPane fx:id="pharmacyContainer"
                                  hgap="25.0"
                                  vgap="25.0"
                                  maxWidth="Infinity"
                                  styleClass="cards-zone"/>
                    </content>
                </ScrollPane>

                <HBox prefHeight="60.0"
                      alignment="CENTER"
                      spacing="16.0"
                      styleClass="modern-pagination-bar">

                    <children>
                        <Label fx:id="totalLabel"
                               text="Total : 0 pharmacies"
                               styleClass="pagination-total"/>

                        <Button text="‹"
                                prefWidth="44.0"
                                prefHeight="40.0"
                                styleClass="pagination-arrow"
                                onAction="#previousPage"/>

                        <Label fx:id="pageLabel"
                               text="Page 1 / 1"
                               styleClass="pagination-page"/>

                        <Button text="›"
                                prefWidth="44.0"
                                prefHeight="40.0"
                                styleClass="pagination-arrow"
                                onAction="#nextPage"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>