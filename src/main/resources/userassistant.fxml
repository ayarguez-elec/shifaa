<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controler.UserAssistantController"
            styleClass="app-root" stylesheets="@pharmacy_style.css">

    

    <center>
        <VBox spacing="24.0" styleClass="page-content">
            <padding>
                <Insets top="42" right="60" bottom="45" left="60"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Assistant intelligent de proximité"
                                       styleClass="admin-page-title"/>

                                <Label text="Trouvez les pharmacies les plus proches selon votre ville ou votre adresse."
                                       styleClass="admin-subtitle"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Retour pharmacies"
                                prefWidth="180.0"
                                prefHeight="42.0"
                                styleClass="dark-button"
                                onAction="#goPharmacies"/>
                    </children>
                </HBox>

                <VBox spacing="14.0"
                      maxWidth="950.0"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 16, 0, 0, 4);">

                    <children>
                        <Label text="Votre emplacement"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0b1f44;"/>

                        <Label text="Saisissez une ville disponible dans les adresses des pharmacies."
                               style="-fx-text-fill: #53627c; -fx-font-size: 13px;"/>

                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <TextField fx:id="locationField"
                                           promptText="Exemple : Tunis, Sousse, Monastir..."
                                           prefHeight="48.0"
                                           HBox.hgrow="ALWAYS"
                                           onAction="#searchNearestPharmacies"
                                           style="-fx-background-color: #f8fafc; -fx-border-color: #dbe4ef; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-padding: 10px;"/>

                                <Button text="Recommander"
                                        prefWidth="155.0"
                                        prefHeight="48.0"
                                        styleClass="red-large-button"
                                        onAction="#searchNearestPharmacies"/>

                                <Button text="Effacer"
                                        prefWidth="110.0"
                                        prefHeight="48.0"
                                        styleClass="dark-button"
                                        onAction="#clearAssistant"/>
                            </children>
                        </HBox>

                        <Label fx:id="infoLabel"
                               text="Saisissez votre emplacement pour afficher les pharmacies les plus proches."
                               style="-fx-text-fill: #53627c; -fx-font-size: 13px;"/>
                    </children>
                </VBox>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="clean-scroll"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;">

                    <content>
                        <FlowPane fx:id="resultsBox"
                                  hgap="20.0"
                                  vgap="20.0"
                                  prefWrapLength="1050.0"
                                  style="-fx-background-color: transparent; -fx-padding: 8px;"/>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </center>

</BorderPane>
