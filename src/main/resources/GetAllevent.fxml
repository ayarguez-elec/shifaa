<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controler.GetAllevent"
            stylesheets="@shifaa.css"
            prefWidth="1100" prefHeight="720">

    <!-- ═══════════════════════════════════════
         MAIN CONTENT
    ════════════════════════════════════════ -->
    <center>
        <VBox style="-fx-background-color:#f0f4f0;">

            <!-- Page Header -->
            <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
                <StackPane styleClass="page-title-icon">
                    <Label text="📅" style="-fx-font-size:20px;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Gestion des Événements"                       styleClass="page-title"/>
                    <Label text="Gérez et suivez tous les événements médicaux" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAjouter"
                        text="＋  Ajouter un événement"
                        styleClass="btn, btn-primary, btn-lg"
                        onAction="#handleAjouter"/>
            </HBox>

            <!-- Stats chips -->
            <HBox styleClass="stats-bar" spacing="14">
                <!-- Total -->
                <HBox styleClass="stat-chip" spacing="10" alignment="CENTER_LEFT">
                    <Label text="📅" styleClass="stat-chip-icon, stat-chip-icon-blue"/>
                    <VBox spacing="1">
                        <Label text="Total événements" styleClass="stat-chip-label"/>
                        <Label fx:id="statTotal" text="0" styleClass="stat-chip-value"/>
                    </VBox>
                </HBox>
                <!-- Actifs -->
                <HBox styleClass="stat-chip" spacing="10" alignment="CENTER_LEFT">
                    <Label text="✅" styleClass="stat-chip-icon, stat-chip-icon-green"/>
                    <VBox spacing="1">
                        <Label text="En cours" styleClass="stat-chip-label"/>
                        <Label fx:id="statActifs" text="0" styleClass="stat-chip-value"/>
                    </VBox>
                </HBox>
                <!-- Planifiés -->
                <HBox styleClass="stat-chip" spacing="10" alignment="CENTER_LEFT">
                    <Label text="📋" styleClass="stat-chip-icon, stat-chip-icon-gray"/>
                    <VBox spacing="1">
                        <Label text="Planifiés" styleClass="stat-chip-label"/>
                        <Label fx:id="statPlanifies" text="0" styleClass="stat-chip-value"/>
                    </VBox>
                </HBox>
                <!-- Terminés -->
                <HBox styleClass="stat-chip" spacing="10" alignment="CENTER_LEFT">
                    <Label text="🏁" styleClass="stat-chip-icon, stat-chip-icon-purple"/>
                    <VBox spacing="1">
                        <Label text="Terminés" styleClass="stat-chip-label"/>
                        <Label fx:id="statTermines" text="0" styleClass="stat-chip-value"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Filters bar -->
            <HBox styleClass="filters-bar" spacing="10" alignment="CENTER_LEFT"
                  style="-fx-margin:0 28 16 28;">
                <TextField fx:id="tfRecherche"
                           promptText="🔍  Rechercher un événement..."
                           styleClass="search-box"
                           onKeyReleased="#handleRecherche"/>
                <ComboBox fx:id="cbFiltreStatut"
                          styleClass="filter-select"
                          onAction="#handleFiltreStatut"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↺  Réinitialiser"
                        styleClass="btn, btn-gray, btn-sm"
                        onAction="#handleActualiser"/>
            </HBox>

            <!-- Total label -->
            <Label fx:id="lblTotal"
                   text="Total : 0 événement(s) trouvé(s)"
                   style="-fx-padding:0 28 10 28;
                          -fx-text-fill:#718096;
                          -fx-font-size:13px;
                          -fx-font-style:italic;"/>

            <!-- ══ CARDS SCROLL AREA ══ -->
            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color:#f0f4f0;
                               -fx-background:#f0f4f0;
                               -fx-border-color:transparent;">
                <VBox.margin>
                    <Insets left="28" right="28" bottom="28"/>
                </VBox.margin>

                <!-- FlowPane wraps cards automatically -->
                <FlowPane fx:id="cardsPane"
                          hgap="20" vgap="20"
                          prefWrapLength="820"
                          style="-fx-background-color:transparent;"/>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
