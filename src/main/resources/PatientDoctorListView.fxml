<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1150.0" style="-fx-background-color: #F7FAFC;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.PatientDoctorListController">
    <VBox spacing="20" style="-fx-padding: 30;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="👨‍⚕️ Nos Docteurs" />
        </HBox>

        <!-- Search and Action Bar -->
        <VBox spacing="15" styleClass="search-group">
            <Label text="Trouver un docteur" style="-fx-text-fill: #FF5C5C; -fx-font-weight: bold; -fx-font-size: 13;" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchNameField" promptText="Nom du docteur ou spécialité..." HBox.hgrow="ALWAYS" prefHeight="45" style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 0 15;" />
            </HBox>
            
            <HBox spacing="20" alignment="BOTTOM_LEFT">
                <VBox spacing="5">
                    <Label text="Spécialité" styleClass="filter-label" />
                    <ComboBox fx:id="specialtyFilter" prefWidth="180" prefHeight="35" promptText="Toutes spécialités" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Localisation" styleClass="filter-label" />
                    <ComboBox fx:id="locationFilter" prefWidth="180" prefHeight="35" promptText="Toutes localisations" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Tri par nom" styleClass="filter-label" />
                    <ComboBox fx:id="sortComboBox" prefWidth="180" prefHeight="35" promptText="Ordre alphabétique" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#resetFilters" text="🔄 Réinitialiser" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold;" prefHeight="35" />
            </HBox>
        </VBox>

        <Label text="Docteurs disponibles" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />

        <!-- Cards Container -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="cardsContainer" hgap="25" vgap="25" style="-fx-padding: 10;" />
        </ScrollPane>

        <!-- Pagination -->
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label fx:id="statusLabel" text="Total: 0 docteurs" style="-fx-text-fill: #718096; -fx-font-size: 14;" />
            <HBox fx:id="paginationBox" spacing="8" alignment="CENTER" />
        </HBox>

    </VBox>
</AnchorPane>