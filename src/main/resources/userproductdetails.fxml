<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.UserProductDetailsController"
            styleClass="app-root">

    <left>
        <VBox prefWidth="260.0" spacing="25.0" styleClass="admin-sidebar">
            <padding>
                <Insets top="45" right="18" bottom="25" left="18"/>
            </padding>

            <children>
                <Label text="💊 SHIFAA" styleClass="admin-logo"/>

                <Button text="Accueil"
                        styleClass="admin-menu-button"
                        onAction="#goDashboard"/>

                <Button text="Produits"
                        styleClass="admin-menu-button-active"
                        onAction="#goProducts"/>

                <Button text="Pharmacies"
                        styleClass="admin-menu-button"
                        onAction="#goPharmacies"/>
            </children>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="clean-scroll"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <content>
                <VBox fx:id="pageContainer"
                      spacing="22.0"
                      styleClass="page-content">

                    <padding>
                        <Insets top="42" right="65" bottom="55" left="65"/>
                    </padding>

                    <children>

                        <HBox fx:id="headerBox" alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Détail du produit"
                                               styleClass="admin-page-title"/>

                                        <Label text="Consultez les informations détaillées du médicament sélectionné."
                                               styleClass="admin-subtitle"/>
                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="topReturnButton"
                                        text="Retour produits"
                                        prefWidth="170.0"
                                        prefHeight="42.0"
                                        style="-fx-background-color: linear-gradient(to right, #6366F1, #4F46E5);
                                               -fx-text-fill: white;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 999;
                                               -fx-cursor: hand;"
                                        onAction="#goBackProducts"/>
                            </children>
                        </HBox>

                        <VBox fx:id="mainCard"
                              spacing="24.0"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 24;
                                     -fx-padding: 30;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0, 0, 5);">

                            <children>

                                <HBox spacing="34.0">
                                    <children>

                                        <VBox fx:id="imageSection"
                                              spacing="18.0"
                                              prefWidth="500.0"
                                              alignment="CENTER">

                                            <children>
                                                <VBox fx:id="imageFrameBox"
                                                      alignment="CENTER"
                                                      prefWidth="500.0"
                                                      prefHeight="390.0"
                                                      style="-fx-background-color: #EFF6FF;
                                                             -fx-background-radius: 22;
                                                             -fx-border-color: #d7e3ef;
                                                             -fx-border-radius: 22;">

                                                    <children>
                                                        <ImageView fx:id="productImage"
                                                                   fitWidth="420.0"
                                                                   fitHeight="330.0"
                                                                   preserveRatio="true"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <VBox fx:id="infoSection"
                                              spacing="18.0"
                                              prefWidth="650.0">

                                            <children>
                                                <Label fx:id="productNameLabel"
                                                       text="PANADOL22"
                                                       wrapText="true"
                                                       style="-fx-font-size: 30px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #0F172A;"/>

                                                <Label fx:id="priceLabel"
                                                       text="0,000 DT"
                                                       style="-fx-font-size: 26px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #10B981;"/>

                                                <Label text="Description"
                                                       style="-fx-font-size: 18px;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #0F172A;"/>

                                                <Label fx:id="descriptionLabel"
                                                       text="AAAAAAA"
                                                       wrapText="true"
                                                       style="-fx-text-fill: #64748B;
                                                              -fx-font-size: 14px;
                                                              -fx-line-spacing: 5;"/>

                                                <VBox fx:id="adviceCard"
                                                      spacing="8.0"
                                                      style="-fx-background-color: white;
                                                             -fx-background-radius: 16;
                                                             -fx-border-color: #e2e8f0;
                                                             -fx-border-radius: 16;
                                                             -fx-padding: 18;">

                                                    <children>
                                                        <Label fx:id="adviceTitle"
                                                               text="💡 Conseils d'utilisation"
                                                               style="-fx-font-size: 16px;
                                                                      -fx-font-weight: bold;
                                                                      -fx-text-fill: #0F172A;"/>

                                                        <Label text="✓ Prendre après les repas pour éviter les troubles gastriques"
                                                               style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>

                                                        <Label text="✓ Ne pas associer avec d'autres médicaments contenant du paracétamol"
                                                               style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>

                                                        <Label text="✓ Consulter un médecin si les symptômes persistent au-delà de 5 jours"
                                                               style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>

                                                        <Label text="✓ Ne pas dépasser la durée de traitement recommandée"
                                                               style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                                                    </children>
                                                </VBox>

                                                <GridPane fx:id="specsGrid"
                                                          hgap="18.0"
                                                          vgap="14.0"
                                                          style="-fx-background-color: #F8FAFC;
                                                                 -fx-background-radius: 18;
                                                                 -fx-padding: 18;">

                                                    <children>
                                                        <Label text="Dosage"
                                                               GridPane.rowIndex="0"
                                                               GridPane.columnIndex="0"
                                                               style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                                        <Label fx:id="dosageLabel"
                                                               text="500mg"
                                                               GridPane.rowIndex="0"
                                                               GridPane.columnIndex="1"
                                                               style="-fx-text-fill: #64748B;"/>

                                                        <Label text="Catégorie"
                                                               GridPane.rowIndex="1"
                                                               GridPane.columnIndex="0"
                                                               style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                                        <Label fx:id="categoryLabel"
                                                               text="1"
                                                               GridPane.rowIndex="1"
                                                               GridPane.columnIndex="1"
                                                               style="-fx-text-fill: #64748B;"/>

                                                        <Label text="Forme"
                                                               GridPane.rowIndex="2"
                                                               GridPane.columnIndex="0"
                                                               style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                                        <Label fx:id="formLabel"
                                                               text="1g"
                                                               GridPane.rowIndex="2"
                                                               GridPane.columnIndex="1"
                                                               style="-fx-text-fill: #64748B;"/>

                                                        <Label text="Laboratoire"
                                                               GridPane.rowIndex="3"
                                                               GridPane.columnIndex="0"
                                                               style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                                        <Label fx:id="laboratoryLabel"
                                                               text="TT"
                                                               GridPane.rowIndex="3"
                                                               GridPane.columnIndex="1"
                                                               style="-fx-text-fill: #64748B;"/>

                                                        <Label text="Classe thérapeutique"
                                                               GridPane.rowIndex="4"
                                                               GridPane.columnIndex="0"
                                                               style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                                                        <Label fx:id="therapeuticClassLabel"
                                                               text="KK"
                                                               GridPane.rowIndex="4"
                                                               GridPane.columnIndex="1"
                                                               style="-fx-text-fill: #64748B;"/>
                                                    </children>
                                                </GridPane>

                                                <Button fx:id="securityButton"
                                                        text="⚠ Sécurité médicament — cliquez pour afficher"
                                                        prefHeight="42.0"
                                                        maxWidth="Infinity"
                                                        style="-fx-background-color: #0F172A;
                                                               -fx-text-fill: white;
                                                               -fx-font-weight: bold;
                                                               -fx-background-radius: 12;
                                                               -fx-cursor: hand;"
                                                        onAction="#toggleSecurity"/>

                                                <VBox fx:id="securityContent"
                                                      visible="false"
                                                      managed="false"
                                                      spacing="6.0"
                                                      style="-fx-background-color: #0F172A;
                                                             -fx-background-radius: 14;
                                                             -fx-padding: 14;">

                                                    <children>
                                                        <Label text="⚠ Ne pas dépasser la dose recommandée."
                                                               style="-fx-text-fill: white;"/>

                                                        <Label text="⚠ Vérifier les contre-indications avant utilisation."
                                                               style="-fx-text-fill: white;"/>

                                                        <Label text="⚠ Demander conseil à un professionnel de santé."
                                                               style="-fx-text-fill: white;"/>

                                                        <Label text="⚠ Garder hors de portée des enfants."
                                                               style="-fx-text-fill: white;"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox fx:id="qrCard"
                                      alignment="CENTER"
                                      spacing="18.0"
                                      style="-fx-background-color: #F8FAFC;
                                             -fx-background-radius: 20;
                                             -fx-border-color: #E2E8F0;
                                             -fx-border-radius: 20;
                                             -fx-padding: 28;
                                             -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.05), 14, 0, 0, 4);">

                                    <children>
                                        <Label text="QR Code disponibilité"
                                               style="-fx-font-size: 22px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #0F172A;"/>

                                        <Label text="Scannez ce QR code pour voir les pharmacies qui contiennent ce médicament."
                                               wrapText="true"
                                               maxWidth="560.0"
                                               style="-fx-text-fill: #64748B;
                                                      -fx-font-size: 14px;
                                                      -fx-text-alignment: center;"/>

                                        <VBox alignment="CENTER"
                                              style="-fx-background-color: white;
                                                     -fx-background-radius: 22;
                                                     -fx-border-color: #E2E8F0;
                                                     -fx-border-radius: 22;
                                                     -fx-padding: 20;">

                                            <children>
                                                <ImageView fx:id="qrImageView"
                                                           fitWidth="280.0"
                                                           fitHeight="280.0"
                                                           preserveRatio="true"/>
                                            </children>
                                        </VBox>

                                        <Label fx:id="qrInfoLabel"
                                               text="QR Code généré pour ce médicament."
                                               wrapText="true"
                                               maxWidth="560.0"
                                               style="-fx-text-fill: #64748B;
                                                      -fx-font-size: 13px;
                                                      -fx-text-alignment: center;"/>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>