<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="950.0" prefHeight="700.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.PatientFeedbackController">

    <VBox spacing="15" style="-fx-padding: 20;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Bouton Retour (tout en haut à gauche) -->
        <Button onAction="#goBack" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-size: 13; -fx-max-width: 100;" text="← Retour" />

        <!-- Titre -->
        <Label fx:id="titleLabel" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-wrap-text: true;" text="⭐ Feedbacks" textFill="#2d3748" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="🔍 Rechercher..." style="-fx-background-radius: 20; -fx-padding: 8; -fx-font-size: 12;" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="ratingCombo" prefWidth="160" style="-fx-font-size: 12;" />
            <ComboBox fx:id="sortCombo" prefWidth="150" style="-fx-font-size: 12;" />
            <Button onAction="#resetFilters" style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-size: 12;" text="↺ Réinitialiser" />
            <Button fx:id="addButton" onAction="#showAddFeedbackDialog" style="-fx-background-color: #FF5C5C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-size: 12;" text="+ AJOUTER" />
        </HBox>

        <!-- Zone de défilement -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <content>
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20" />
            </content>
        </ScrollPane>

        <!-- Status -->
        <Label fx:id="statusLabel" style="-fx-text-fill: #718096; -fx-font-size: 13;" text="Chargement des feedbacks..." />

    </VBox>
</AnchorPane>