<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane prefWidth="1150.0" prefHeight="800.0" style="-fx-background-color: #F7FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.AdminFeedbackController">
    <VBox spacing="20" style="-fx-padding: 30;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="⭐ Gestion des Avis" />
        </HBox>

        <VBox spacing="15" styleClass="search-group" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <Label text="Rechercher un avis" style="-fx-text-fill: #FF5C5C; -fx-font-weight: bold; -fx-font-size: 13;" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher par commentaire ou auteur..." HBox.hgrow="ALWAYS" prefHeight="45" style="-fx-background-color: #F7FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 0 15;" />
            </HBox>
            
            <HBox spacing="20" alignment="BOTTOM_LEFT">
                <VBox spacing="5">
                    <Label text="Cible" style="-fx-font-size: 11; -fx-text-fill: #718096; -fx-font-weight: bold;" />
                    <ComboBox fx:id="targetTypeFilter" prefWidth="180" prefHeight="35" promptText="Toutes les cibles" />
                </VBox>
                <VBox spacing="5">
                    <Label text="Note" style="-fx-font-size: 11; -fx-text-fill: #718096; -fx-font-weight: bold;" />
                    <ComboBox fx:id="ratingFilter" prefWidth="150" prefHeight="35" promptText="Toutes les notes" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#resetFilters" text="🔄 Réinitialiser" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-font-weight: bold;" prefHeight="35" />
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="cardsContainer" hgap="25" vgap="25" style="-fx-padding: 10;" />
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label fx:id="statusLabel" text="Total: 0 avis" style="-fx-text-fill: #718096; -fx-font-size: 14;" />
            <HBox fx:id="paginationBox" spacing="8" alignment="CENTER" />
        </HBox>

    </VBox>
</AnchorPane>
