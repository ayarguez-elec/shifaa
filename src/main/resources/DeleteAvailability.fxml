<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            styleClass="root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controler.DeleteAvailability">
    <children>
        <!-- Sidebar -->
        <AnchorPane prefHeight="650.0" prefWidth="220.0" styleClass="sidebar">
            <children>
                <Label layoutX="30.0" layoutY="40.0" text="SHIFAA" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Button layoutY="120.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button" text="Tableau de bord"/>
                <Button layoutY="170.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button" text="Rendez-vous"/>
                <Button layoutY="220.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button-active" text="Disponibilités"/>
            </children>
        </AnchorPane>

        <Label layoutX="260.0" layoutY="30.0"
               style="-fx-font-size: 22; -fx-font-weight: bold;"
               text="Supprimer une Disponibilité" textFill="#2d3748"/>

        <Label layoutX="260.0" layoutY="100.0"
               text="Entrer l'ID de la disponibilité à supprimer :"/>
        <TextField fx:id="availabilityIdField" layoutX="260.0" layoutY="125.0"
                   prefWidth="250.0" promptText="ID Disponibilité"/>
        <Button layoutX="525.0" layoutY="125.0"
                prefHeight="30.0" prefWidth="110.0"
                styleClass="btn-primary" text="Rechercher"
                onAction="#rechercherDisponibilite"/>

        <!-- Aperçu -->
        <Label layoutX="260.0" layoutY="185.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Aperçu de la disponibilité"/>

        <Label layoutX="260.0" layoutY="215.0" text="Médecin ID :"/>
        <TextField fx:id="previewDoctor" layoutX="370.0" layoutY="212.0"
                   prefWidth="150.0" editable="false"
                   style="-fx-background-color: #EDF2F7;"/>

        <Label layoutX="550.0" layoutY="215.0" text="Date :"/>
        <TextField fx:id="previewDate" layoutX="620.0" layoutY="212.0"
                   prefWidth="150.0" editable="false"
                   style="-fx-background-color: #EDF2F7;"/>

        <Label layoutX="260.0" layoutY="255.0" text="Heure :"/>
        <TextField fx:id="previewTime" layoutX="370.0" layoutY="252.0"
                   prefWidth="150.0" editable="false"
                   style="-fx-background-color: #EDF2F7;"/>

        <Label layoutX="550.0" layoutY="255.0" text="Statut :"/>
        <TextField fx:id="previewStatus" layoutX="620.0" layoutY="252.0"
                   prefWidth="150.0" editable="false"
                   style="-fx-background-color: #EDF2F7;"/>

        <Label fx:id="messageLabel" layoutX="260.0" layoutY="330.0"
               style="-fx-text-fill: #38A169;"/>

        <Button layoutX="260.0" layoutY="370.0"
                prefHeight="40.0" prefWidth="150.0"
                styleClass="btn-primary" text="Supprimer"
                onAction="#supprimerDisponibilite"/>
    </children>
</AnchorPane>