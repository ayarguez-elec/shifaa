<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1300.0" styleClass="root" stylesheets="@style.css" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="Controler.ModifierPrescriptionController">

    <!-- ================= MAIN CONTENT AREA ================= -->
    <center>
        <VBox spacing="25.0" style="-fx-background-color: #F7FAFC; -fx-padding: 30;">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button onAction="#retourner" styleClass="btn-secondary" text="← Annuler" />
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Modifier la Prescription Médicale" />
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F7FAFC;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <children>
                                <Label style="-fx-font-size: 20; -fx-text-fill: #009929; -fx-font-weight: bold;" text="1. Informations Générales" />
                                <Separator />
                                
                                <GridPane hgap="40.0" vgap="25.0">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50.0" />
                                        <ColumnConstraints percentWidth="50.0" />
                                    </columnConstraints>
                                    <children>
                                        <VBox spacing="8.0" GridPane.columnIndex="0">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A5568;" text="PATIENT CONCERNÉ :" />
                                            <ComboBox fx:id="comboPatient" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-radius: 10;" />
                                        </VBox>
                                        
                                        <VBox spacing="8.0" GridPane.columnIndex="1">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A5568;" text="DATE DE PRESCRIPTION :" />
                                            <DatePicker fx:id="datePrescription" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-radius: 10;" />
                                        </VBox>
                                        
                                        <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4A5568;" text="DURÉE DU TRAITEMENT :" />
                                            <HBox spacing="10.0">
                                                <children>
                                                    <TextField fx:id="txtDuree" prefHeight="45.0" style="-fx-background-radius: 10;" HBox.hgrow="ALWAYS" />
                                                    <Button onAction="#handleVoiceInput" prefHeight="45.0" style="-fx-background-color: #EDF2F7; -fx-background-radius: 10;" text="🎙" userData="txtDuree" />
                                                </children>
                                            </HBox>
                                        </VBox>
                                    </children>
                           <rowConstraints>
                              <RowConstraints />
                              <RowConstraints />
                           </rowConstraints>
                                </GridPane>
                                
                                <VBox spacing="10.0">
                                    <children>
                                        <Label style="-fx-font-size: 20; -fx-text-fill: #009929; -fx-font-weight: bold;" text="2. Mise à jour de l'Ordonnance" />
                                        <Separator />
                                        <HBox spacing="10.0">
                                            <children>
                                                <TextArea fx:id="txtPrescription" prefHeight="250.0" style="-fx-background-radius: 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 14;" wrapText="true" HBox.hgrow="ALWAYS" />
                                                <Button onAction="#handleVoiceInput" prefHeight="45.0" style="-fx-background-color: #EDF2F7; -fx-background-radius: 10;" text="🎙" userData="txtPrescription" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                
                                <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-padding: 20 0 0 0;">
                                    <children>
                                        <Button onAction="#retourner" prefHeight="50.0" prefWidth="150.0" styleClass="btn-secondary" text="Annuler" />
                                        <Button onAction="#enregistrerModifications" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #2D3748;" styleClass="btn-primary" text="💾 Enregistrer les modifications" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
