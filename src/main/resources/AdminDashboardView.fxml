<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="900.0" prefWidth="1150.0" style="-fx-background-color: #F0F4F8;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controler.AdminMainDashboardController">

    <ScrollPane fitToWidth="true" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="22" style="-fx-padding: 28;">

            <!-- ══════════════ HERO BANNER ══════════════ -->
            <HBox style="-fx-background-color: linear-gradient(to right, #FF5C5C, #c0392b);
                         -fx-background-radius: 20; -fx-padding: 28 40;
                         -fx-effect: dropshadow(gaussian, rgba(255,92,92,0.35), 20, 0, 0, 8);"
                  alignment="CENTER_LEFT" spacing="0">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label fx:id="dateLabel" text="Dimanche, 11 Mai 2026"
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.75);
                                  -fx-background-color: rgba(255,255,255,0.15);
                                  -fx-background-radius: 20; -fx-padding: 4 12;" />
                    <Label fx:id="greetingLabel" text="Bonjour, Administrateur ! 👋"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="Voici un résumé de votre plateforme aujourd'hui."
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.80);" />
                    <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Button onAction="#goToAllPending" text="⏳ Demandes en attente"
                                style="-fx-background-color: white; -fx-text-fill: #FF5C5C;
                                       -fx-font-weight: bold; -fx-background-radius: 10;
                                       -fx-padding: 7 16; -fx-cursor: hand; -fx-font-size: 12;" />
                        <Button onAction="#goToAllUsers" text="👥 Gérer les utilisateurs"
                                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 10;
                                       -fx-padding: 7 16; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-border-color: rgba(255,255,255,0.5); -fx-border-radius: 10;" />
                    </HBox>
                </VBox>
                <StackPane prefWidth="180" prefHeight="110" alignment="CENTER">
                    <Label text="🏥" style="-fx-font-size: 80; -fx-opacity: 0.20;" />
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="SHIFAA" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white; -fx-opacity: 0.9;" />
                        <Label text="Administration" style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.65);" />
                    </VBox>
                </StackPane>
            </HBox>

            <!-- ══════════════ STATS CARDS ══════════════ -->
            <HBox spacing="15">
                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #EBF8FF; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="👥" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="TOTAL" style="-fx-font-size: 9; -fx-text-fill: #A0AEC0; -fx-font-weight: bold;" />
                            <Label fx:id="totalUsersLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                        </VBox>
                    </HBox>
                    <Label text="Utilisateurs" style="-fx-font-size: 10; -fx-text-fill: #718096;" />
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #F6AD55; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #FFFAF0; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="⏳" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="EN ATTENTE" style="-fx-font-size: 9; -fx-text-fill: #C05621; -fx-font-weight: bold;" />
                            <Label fx:id="pendingUsersLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #C05621;" />
                        </VBox>
                    </HBox>
                    <Label text="À valider" style="-fx-font-size: 10; -fx-text-fill: #C05621;" />
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #68D391; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #F0FFF4; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="✅" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="ACTIFS" style="-fx-font-size: 9; -fx-text-fill: #276749; -fx-font-weight: bold;" />
                            <Label fx:id="activeUsersLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #276749;" />
                        </VBox>
                    </HBox>
                    <Label text="Comptes actifs" style="-fx-font-size: 10; -fx-text-fill: #276749;" />
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #90CDF4; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #EBF8FF; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="🩺" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="MÉDECINS" style="-fx-font-size: 9; -fx-text-fill: #2B6CB0; -fx-font-weight: bold;" />
                            <Label fx:id="doctorsLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2B6CB0;" />
                        </VBox>
                    </HBox>
                    <Label text="Médecins" style="-fx-font-size: 10; -fx-text-fill: #2B6CB0;" />
                </VBox>

                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #FC8181; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #FFF5F5; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="🏥" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="PATIENTS" style="-fx-font-size: 9; -fx-text-fill: #C53030; -fx-font-weight: bold;" />
                            <Label fx:id="patientsLabel" text="0" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #C53030;" />
                        </VBox>
                    </HBox>
                    <Label text="Patients" style="-fx-font-size: 10; -fx-text-fill: #C53030;" />
                </VBox>
            </HBox>

            <!-- ══════════════ ROW 2: Pending + Recent ══════════════ -->
            <HBox spacing="20">
                <!-- Pending approvals -->
                <VBox spacing="13" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4); -fx-padding: 22;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="⏳ Demandes en attente" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                        <Label fx:id="pendingCountBadge" text="0"
                               style="-fx-background-color: #FF5C5C; -fx-text-fill: white;
                                      -fx-background-radius: 20; -fx-padding: 2 9;
                                      -fx-font-weight: bold; -fx-font-size: 11;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#goToAllPending" text="Voir tout →"
                                style="-fx-background-color: transparent; -fx-text-fill: #FF5C5C;
                                       -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;" />
                    </HBox>
                    <Separator />
                    <VBox fx:id="pendingContainer" spacing="10">
                        <Label text="Aucune demande" style="-fx-text-fill: #A0AEC0; -fx-font-size: 13;" />
                    </VBox>
                </VBox>

                <!-- Recent members -->
                <VBox spacing="13" prefWidth="320"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4); -fx-padding: 22;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🆕 Membres récents" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#goToAllUsers" text="Voir tout →"
                                style="-fx-background-color: transparent; -fx-text-fill: #FF5C5C;
                                       -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;" />
                    </HBox>
                    <Separator />
                    <VBox fx:id="recentContainer" spacing="9">
                        <Label text="Chargement..." style="-fx-text-fill: #A0AEC0; -fx-font-size: 13;" />
                    </VBox>
                </VBox>
            </HBox>

            <!-- ══════════════ ROW 3: Pie Chart + Calendar ══════════════ -->
            <HBox spacing="20">

                <!-- PIE CHART: Répartition des utilisateurs -->
                <VBox spacing="13" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4); -fx-padding: 22;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊 Répartition des utilisateurs" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                    </HBox>
                    <Separator />
                    <PieChart fx:id="userPieChart" prefHeight="250"
                              labelsVisible="true" legendVisible="true"
                              legendSide="BOTTOM"
                              style="-fx-background-color: transparent;" />
                </VBox>

                <!-- CALENDAR — nouveau style semaine + événements -->
                <VBox spacing="0" prefWidth="400"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4);">

                    <!-- ── En-tête bleu ── -->
                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-background-color: #4A6CF7;
                                 -fx-background-radius: 16 16 0 0; -fx-padding: 18 20;">
                        <Label text="MY CALENDAR"
                               style="-fx-font-size: 14; -fx-font-weight: bold;
                                      -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="6"
                              style="-fx-background-color: rgba(255,255,255,0.20);
                                     -fx-background-radius: 8; -fx-padding: 5 10;">
                            <Button onAction="#prevWeek" text="◀"
                                    style="-fx-background-color: transparent; -fx-text-fill: white;
                                           -fx-cursor: hand; -fx-padding: 0 4; -fx-font-size: 10;" />
                            <Label fx:id="monthYearLabel" text="Mai 2026"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: white;" />
                            <Button onAction="#nextWeek" text="▶"
                                    style="-fx-background-color: transparent; -fx-text-fill: white;
                                           -fx-cursor: hand; -fx-padding: 0 4; -fx-font-size: 10;" />
                        </HBox>
                    </HBox>

                    <!-- ── Rangée des 7 jours ── -->
                    <HBox fx:id="weekRow" alignment="CENTER" spacing="0"
                          style="-fx-background-color: #EEF2FF; -fx-padding: 14 16;" />

                    <!-- ── Section événements ── -->
                    <VBox spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 0 0 16 16; -fx-padding: 16 20 20 20;">

                        <!-- Titre date + bouton Ajouter -->
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 10 0;">
                            <Label fx:id="selectedDateLabel" text="MAI, 11"
                                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #4A5568;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#openAddEventForm" text="+ Ajouter"
                                    style="-fx-background-color: #4A6CF7; -fx-text-fill: white;
                                           -fx-font-size: 11; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-padding: 4 12; -fx-cursor: hand;" />
                        </HBox>

                        <!-- Formulaire d'ajout (caché par défaut) -->
                        <VBox fx:id="addEventForm" spacing="8" managed="false" visible="false"
                              style="-fx-background-color: #F8FAFF; -fx-background-radius: 12;
                                     -fx-border-color: #C7D2FE; -fx-border-radius: 12;
                                     -fx-border-width: 1; -fx-padding: 14; -fx-margin: 0 0 10 0;">

                            <!-- Titre -->
                            <TextField fx:id="eventTitleField" promptText="Titre de l'événement"
                                       style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 7 10; -fx-font-size: 12;" />

                            <!-- Heure + Type sur la même ligne -->
                            <HBox spacing="8">
                                <TextField fx:id="eventTimeField" promptText="HH:mm"
                                           prefWidth="80"
                                           style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                                  -fx-padding: 7 10; -fx-font-size: 12;" />
                                <ComboBox fx:id="eventTypeCombo" promptText="Type"
                                          HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                          style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                                 -fx-font-size: 12;" />
                            </HBox>

                            <!-- Description -->
                            <TextArea fx:id="eventDescField" promptText="Description (optionnel)"
                                      prefRowCount="2"
                                      style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-padding: 7 10; -fx-font-size: 12;" />

                            <!-- Boutons Confirmer / Annuler -->
                            <HBox spacing="8" alignment="CENTER_RIGHT">
                                <Button onAction="#cancelAddEvent" text="Annuler"
                                        style="-fx-background-color: #E2E8F0; -fx-text-fill: #4A5568;
                                               -fx-font-size: 11; -fx-background-radius: 8;
                                               -fx-padding: 6 14; -fx-cursor: hand;" />
                                <Button onAction="#confirmAddEvent" text="✓ Enregistrer"
                                        style="-fx-background-color: #4A6CF7; -fx-text-fill: white;
                                               -fx-font-size: 11; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;" />
                            </HBox>
                        </VBox>

                        <!-- Liste des événements -->
                        <ScrollPane fitToWidth="true" prefHeight="200" maxHeight="200"
                                    style="-fx-background-color: transparent; -fx-background: transparent;
                                           -fx-border-color: transparent;">
                            <VBox fx:id="eventsContainer" spacing="0" />
                        </ScrollPane>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
