<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900.0" prefWidth="1536.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminProductPharmaciesController"
            styleClass="app-root">

    <left>
        <VBox prefWidth="260.0"
              spacing="25.0"
              styleClass="admin-sidebar">

            <padding>
                <Insets top="45" right="18" bottom="25" left="18"/>
            </padding>

            <children>
                <Label text="💊 SHIFAA ADMIN"
                       styleClass="admin-logo"/>

                <Button text="Accueil"
                        styleClass="admin-menu-button"
                        onAction="#goDashboard"/>

                <Button text="Produits"
                        styleClass="admin-menu-button-active"
                        onAction="#goProducts"/>

                <Button text="Pharmacies"
                        styleClass="admin-menu-button"
                        onAction="#goPharmacies"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="22.0"
              styleClass="page-content">

            <padding>
                <Insets top="42" right="55" bottom="35" left="55"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="20.0">

                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Pharmacies disponibles"
                                       styleClass="admin-page-title"/>

                                <Label fx:id="productTitleLabel"
                                       text="Liste des pharmacies contenant ce médicament"
                                       styleClass="admin-subtitle"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Retour produits"
                                prefWidth="170.0"
                                prefHeight="46.0"
                                styleClass="dark-button"
                                onAction="#goBack"/>
                    </children>
                </HBox>

                <HBox spacing="24.0">

                    <children>

                        <VBox spacing="16.0"
                              prefWidth="310.0"
                              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 22; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.08), 18, 0, 0, 6);">

                            <children>
                                <Label text="QR Code disponibilité"
                                       styleClass="product-section-title"/>

                                <Label text="Scanner ce QR code pour voir la liste des pharmacies qui contiennent ce médicament."
                                       wrapText="true"
                                       styleClass="admin-subtitle"/>

                                <ImageView fx:id="qrImageView"
                                           fitWidth="230.0"
                                           fitHeight="230.0"
                                           preserveRatio="true"/>

                                <Label text="Le QR code contient le nom du médicament, les pharmacies disponibles et les quantités."
                                       wrapText="true"
                                       styleClass="admin-subtitle"/>
                            </children>
                        </VBox>

                        <VBox spacing="14.0"
                              HBox.hgrow="ALWAYS">

                            <children>
                                <HBox alignment="CENTER_LEFT"
                                      spacing="16.0">

                                    <children>
                                        <Label fx:id="totalLabel"
                                               text="Total : 0 pharmacie"
                                               styleClass="pagination-total"/>
                                    </children>
                                </HBox>

                                <ScrollPane fitToWidth="true"
                                            VBox.vgrow="ALWAYS"
                                            styleClass="clean-scroll">

                                    <content>
                                        <FlowPane fx:id="pharmacyContainer"
                                                  hgap="24.0"
                                                  vgap="24.0"
                                                  prefWrapLength="850.0"
                                                  styleClass="cards-zone"/>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>