<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0"
            styleClass="root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controler.DashboardDoctor">

    <children>
        <!-- ================= SIDEBAR ================= -->
        <VBox prefHeight="700.0" prefWidth="230" minWidth="230" styleClass="sidebar"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Logo -->
            <VBox styleClass="sidebar-profile" alignment="CENTER" spacing="4">
                <padding><Insets top="20" bottom="10"/></padding>
                <Label text="🏥 SHIFAA" styleClass="sidebar-title"/>
                <Label text="Espace médecin" styleClass="sidebar-subtitle"/>
            </VBox>

            <!-- Avatar Médecin -->
            <VBox styleClass="sidebar-profile" alignment="CENTER" spacing="8">
                <padding><Insets top="10" bottom="16"/></padding>
                <ImageView fitWidth="72" fitHeight="72" preserveRatio="false" smooth="true">
                    <image><Image url="@avatar_doctor.png"/></image>
                    <clip><Circle radius="36" centerX="36" centerY="36"/></clip>
                </ImageView>
                <Label fx:id="doctorNameLabel" text="Dr. John Doe" styleClass="sidebar-profile-name"/>
                <Label fx:id="doctorIdLabel"   text="Médecin"     styleClass="sidebar-profile-role"/>
            </VBox>

            <Separator opacity="0.15"/>

            <Label text="MON ACTIVITÉ" styleClass="menu-section-title"/>

            <Button prefWidth="210" maxWidth="210" styleClass="menu-button-active"
                    text="🗓️  Planning du Jour" alignment="BASELINE_LEFT"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="v1.0 — SHIFAA" styleClass="sidebar-subtitle"
                   style="-fx-padding: 0 0 14 20; -fx-text-fill: #374151;"/>
        </VBox>

        <!-- ================= MAIN CONTENT ================= -->
        <VBox layoutX="230.0" prefHeight="700.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="230.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
              styleClass="main-content">

            <!-- COLORED HEADER STRIP (WITH DATEPICKER) -->
            <HBox style="-fx-background-color: linear-gradient(to right, #10B981, #059669);
                         -fx-padding: 20 40 20 40; -fx-background-radius: 0 0 16 16;"
                  alignment="CENTER_LEFT">
                <children>
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Planning"           styleClass="page-title-white" style="-fx-font-size: 28px;"/>
                        <Label text="Vos rendez-vous confirmés" styleClass="page-subtitle-white"/>
                    </VBox>
                    <HBox alignment="CENTER" spacing="10">
                        <children>
                            <Label text="Date :" styleClass="page-title-white" style="-fx-font-size: 16px;"/>
                            <DatePicker fx:id="inlineDatePicker" onAction="#loadPlanning" prefWidth="180"
                                        style="-fx-background-radius: 8;"/>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <!-- MAIN BODY -->
            <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 25 40 30 40;" spacing="20">
                <children>
                    
                    <!-- NOTIFICATION -->
                    <Label fx:id="messageLabel" style="-fx-padding: 0 0 10 0;" visible="false"/>

                    <!-- ======= PLANNING TABLE-LIKE CONTAINER ======= -->
                    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                        <children>
                            <!-- TABLE HEADERS -->
                            <HBox style="-fx-padding: 15 25 15 25; -fx-border-color: #F1F5F9; -fx-border-width: 0 0 1 0;">
                                <children>
                                    <Label text="HEURE"     prefWidth="100" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                                    <Label text="PATIENT"    prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                                    <Label text="TYPE"       prefWidth="120" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                                    <Label text="RAISON"     HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                                    <Label text="STATUT"     prefWidth="100" alignment="CENTER" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                                </children>
                            </HBox>

                            <!-- SCROLLABLE CONTENT -->
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="planningContainer" spacing="1" style="-fx-padding: 0;">
                                        <!-- List items will be added here -->
                                        <Label text="Aucun rendez-vous confirmé pour cette date." style="-fx-padding: 40; -fx-text-fill: #94A3B8; -fx-font-size: 14px;"/>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </children>
                    </VBox>

                    <!-- FOOTER STATS (Small) -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                            <Circle radius="6" fill="#10B981"/>
                            <Label text="Aujourd'hui :" style="-fx-font-weight: bold;"/>
                            <Label fx:id="statDayCount" text="0" style="-fx-font-weight: bold; -fx-text-fill: #10B981;"/>
                            <Label text="rendez-vous prévu(s)"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
