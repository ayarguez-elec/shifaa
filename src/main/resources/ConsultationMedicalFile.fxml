<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="800.0" prefWidth="1300.0" styleClass="root" stylesheets="@style.css" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="Controler.ConsultationMedicalFileController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <!-- App Logo -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 0 0 40 0;">
                    <children>
                        <Label styleClass="sidebar-logo" text="SHIFAA" />
                        <Label style="-fx-text-fill: #FF5C5C; -fx-font-weight: bold; -fx-font-size: 22;" text="+" />
                    </children>
                </HBox>

                <!-- Doctor Profile -->
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0 0 50 0;">
                    <children>
                        <StackPane maxWidth="120.0">
                            <children>
                                <Circle fx:id="circleImage" fill="#2D3748" radius="60.0" stroke="#4A5568" strokeType="INSIDE" strokeWidth="2.0" />
                                <ImageView fx:id="imgDoctor" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                                    <clip>
                                        <Circle centerX="60.0" centerY="60.0" radius="60.0" />
                                    </clip>
                                </ImageView>
                            </children>
                        </StackPane>
                        <Label fx:id="lblDoctorName" styleClass="sidebar-patient-name" text="Dr. Saif Gharbi" />
                    </children>
                </VBox>

                <!-- Navigation Menu -->
                <VBox spacing="5.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-item">
                            <children>
                                <Label style="-fx-font-size: 18;" text="🏠" />
                                <Label text="Tableau de bord" />
                            </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#closeWindow" spacing="15.0" styleClass="menu-item, menu-item-active">
                            <children>
                                <Label style="-fx-font-size: 18;" text="👥" />
                                <Label text="Gérer les Patients" />
                            </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-item">
                            <children>
                                <Label style="-fx-font-size: 18;" text="💊" />
                                <Label text="Gérer les Prescriptions" />
                            </children>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-item" style="-fx-padding: 30 25 30 25;">
                            <children>
                                <Label style="-fx-font-size: 18;" text="🚪" />
                                <Label text="Déconnexion" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT AREA ================= -->
    <center>
        <VBox spacing="20.0" style="-fx-background-color: #F7FAFC; -fx-padding: 30;">
            <children>
                <!-- Header with Back Button -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button onAction="#closeWindow" styleClass="btn-secondary" text="← Retour à la liste" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Consultation Dossier Médical" />
                    </children>
                </HBox>

                <!-- Patient Identity Card -->
                <HBox spacing="30.0" style="-fx-background-color: #2D3748; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <StackPane alignment="CENTER" prefHeight="90.0" prefWidth="90.0">
                            <children>
                                <Circle fill="#4A5568" radius="45.0" stroke="WHITE" strokeType="INSIDE" strokeWidth="2.0" />
                                <ImageView fx:id="patientPhoto" fitHeight="90.0" fitWidth="90.0" pickOnBounds="true">
                                    <clip>
                                        <Circle centerX="45.0" centerY="45.0" radius="45.0" />
                                    </clip>
                                </ImageView>
                            </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="5.0">
                            <children>
                                <Label fx:id="lblPatientName" text="Nom du Patient" textFill="WHITE" style="-fx-font-size: 28; -fx-font-weight: bold;" />
                                <Label fx:id="lblDossierId" text="Dossier #001" textFill="#CBD5E0" style="-fx-font-size: 16;" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Label text="STATUT ACTUEL" textFill="#A0AEC0" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                <Label fx:id="lblStatus" styleClass="card-badge" text="STABLE" style="-fx-font-size: 14; -fx-padding: 8 15;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Date Info Row -->
                <HBox spacing="20.0">
                    <children>
                        <VBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                            <Label text="📅 DATE DE CRÉATION" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 12;" />
                            <Label fx:id="lblCreationDate" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2D3748;" text="2024-01-01" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                            <Label text="🏥 DERNIÈRE VISITE" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 12;" />
                            <Label fx:id="lblLastVisit" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #FF5C5C;" text="2024-05-17" />
                        </VBox>
                    </children>
                </HBox>

                <!-- Medical Data Grid -->
                <GridPane hgap="25.0" vgap="25.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints percentHeight="50.0" />
                        <RowConstraints percentHeight="50.0" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15;">
                            <Label text="📖 Historique Général" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2D3748;" />
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                                <Label fx:id="txtHistory" wrapText="true" text="..." style="-fx-text-fill: #4A5568; -fx-font-size: 15; -fx-line-spacing: 5;" />
                            </ScrollPane>
                        </VBox>

                        <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15;">
                            <Label text="📜 Antécédents" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2D3748;" />
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                                <Label fx:id="txtAntecedents" wrapText="true" text="..." style="-fx-text-fill: #4A5568; -fx-font-size: 15; -fx-line-spacing: 5;" />
                            </ScrollPane>
                        </VBox>

                        <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-background-color: #FFF5F5; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #FED7D7; -fx-border-radius: 15;">
                            <Label text="🚫 Allergies" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #C53030;" />
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                                <Label fx:id="txtAllergies" wrapText="true" text="..." style="-fx-text-fill: #C53030; -fx-font-size: 15; -fx-font-weight: bold; -fx-line-spacing: 5;" />
                            </ScrollPane>
                        </VBox>

                        <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15;">
                            <Label text="📌 Suivi &amp; Observations" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2D3748;" />
                            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                                <Label fx:id="txtFollowup" wrapText="true" text="..." style="-fx-text-fill: #4A5568; -fx-font-size: 15; -fx-line-spacing: 5;" />
                            </ScrollPane>
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </VBox>
    </center>
</BorderPane>
