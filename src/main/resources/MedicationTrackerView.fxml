<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.MedicationTrackerController">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox>
                            <Label text="Mon Pilulier Numérique" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                            <Label text="Gérez vos prises de médicaments quotidiennes" textFill="#64748B" />
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- ADD FORM -->
                <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <children>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Nom du médicament" style="-fx-font-size: 11; -fx-text-fill: #94A3B8;" />
                            <TextField fx:id="medNameField" promptText="ex: Paracétamol" style="-fx-background-radius: 8;" />
                        </VBox>
                        <VBox spacing="5" prefWidth="150">
                            <Label text="Dosage" style="-fx-font-size: 11; -fx-text-fill: #94A3B8;" />
                            <TextField fx:id="dosageField" promptText="ex: 500mg" style="-fx-background-radius: 8;" />
                        </VBox>
                        <VBox spacing="5" prefWidth="120">
                            <Label text="Heure" style="-fx-font-size: 11; -fx-text-fill: #94A3B8;" />
                            <TextField fx:id="timeField" promptText="HH:mm" style="-fx-background-radius: 8;" />
                        </VBox>
                        <Button onAction="#handleAddMedication" prefHeight="40" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Ajouter" />
                    </children>
                </HBox>

                <!-- PILL LIST -->
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="PROGRAMME DU JOUR" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" />
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <VBox fx:id="pillContainer" spacing="12">
                                <!-- Cards injected here -->
                            </VBox>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
