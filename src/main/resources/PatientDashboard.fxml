<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="root" stylesheets="@style.css" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="Controler.PatientDashboardController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <children>
                <!-- App Logo -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 0 0 40 0;">
                    <children>
                        <Label styleClass="sidebar-logo" text="SHIFAA" />
                        <Label style="-fx-text-fill: #FF5C5C; -fx-font-weight: bold; -fx-font-size: 22;" text="+" />
                    </children>
                </HBox>

                <!-- Patient Profile -->
                <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0 0 50 0;">
                    <children>
                        <StackPane maxWidth="120.0">
                            <children>
                                <Circle fx:id="circleImage" fill="#2D3748" radius="60.0" stroke="#4A5568" strokeType="INSIDE" strokeWidth="2.0" />
                                <ImageView fx:id="imgPatient" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                                    <clip>
                                        <Circle centerX="60.0" centerY="60.0" radius="60.0" />
                                    </clip>
                                </ImageView>
                            </children>
                        </StackPane>
                        <Label fx:id="lblPatientName" styleClass="sidebar-patient-name" text="John Doe" />
                    </children>
                </VBox>

                <!-- Navigation Menu -->
                <VBox spacing="5.0">
                    <children>
                        <HBox fx:id="btnNavDashboard" alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-item, menu-item-active">
                            <children>
                                <Label style="-fx-font-size: 18;" text="🏠" />
                                <Label text="Tableau de bord" />
                            </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#ouvrirMonDossier" spacing="15.0" styleClass="menu-item">
                            <children>
                                <Label style="-fx-font-size: 18;" text="📋" />
                                <Label text="Mon Dossier Médical" />
                            </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#ouvrirMesPrescriptions" spacing="15.0" styleClass="menu-item">
                            <children>
                                <Label style="-fx-font-size: 18;" text="💊" />
                                <Label text="Mes Ordonnances" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-item">
                            <children>
                                <Label style="-fx-font-size: 18;" text="📅" />
                                <Label text="Mes Rendez-vous" />
                            </children>
                        </HBox>
                        
                        <Region VBox.vgrow="ALWAYS" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-item" style="-fx-padding: 30 25 30 25;">
                            <children>
                                <Label style="-fx-font-size: 18;" text="🚪" />
                                <Label text="Déconnexion" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox alignment="CENTER" spacing="40.0" style="-fx-background-color: #F7FAFC; -fx-padding: 40;">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblWelcome" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Bienvenue dans votre espace santé" />
                        <Label style="-fx-font-size: 16; -fx-text-fill: #718096;" text="Gérez votre santé en toute simplicité" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="30.0">
                    <children>
                        <!-- Card: Mon Dossier -->
                        <VBox alignment="CENTER" onMouseClicked="#ouvrirMonDossier" prefHeight="280.0" prefWidth="280.0" 
                              styleClass="action-card-patient" style="-fx-background-color: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 25;">
                            <children>
                                <Label style="-fx-font-size: 60;" text="📋" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2D3748; -fx-padding: 15 0 5 0;" text="Mon Dossier" />
                                <Label style="-fx-font-size: 14; -fx-text-fill: #718096; -fx-text-alignment: center;" text="Consultez vos antécédents et votre historique médical" wrapText="true" />
                                <Region prefHeight="20.0" />
                                <Button onAction="#ouvrirMonDossier" prefHeight="40.0" prefWidth="150.0" styleClass="btn-primary" text="Accéder" />
                            </children>
                        </VBox>
 
                        <VBox alignment="CENTER" onMouseClicked="#ouvrirMesPrescriptions" prefHeight="280.0" prefWidth="280.0" 
                              styleClass="action-card-patient" style="-fx-background-color: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5); -fx-padding: 25;">
                            <children>
                                <Label style="-fx-font-size: 60;" text="💊" />
                                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2D3748; -fx-padding: 15 0 5 0;" text="Mes Ordonnances" />
                                <Label style="-fx-font-size: 14; -fx-text-fill: #718096; -fx-text-alignment: center;" text="Retrouvez toutes vos prescriptions médicales" wrapText="true" />
                                <Region prefHeight="20.0" />
                                <Button onAction="#ouvrirMesPrescriptions" prefHeight="40.0" prefWidth="150.0" styleClass="btn-primary" text="Accéder" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
