<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1300.0" styleClass="root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controler.PrescriptionController">

    <!-- ================= MAIN CONTENT AREA ================= -->
    <center>
        <VBox spacing="25.0" style="-fx-background-color: #F7FAFC; -fx-padding: 30;">
            <children>
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Button onAction="#allerGererPatients" styleClass="btn-secondary" text="← Retour à la liste" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Ordonnances du Patient" />
                    </children>
                </HBox>

                <!-- Search Area -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                            <children>
                                <VBox spacing="5" HBox.hgrow="ALWAYS">
                                    <Label style="-fx-font-size: 12; -fx-text-fill: #718096; -fx-font-weight: bold;" text="📅 Filtrer par Date de Prescription" />
                                    <DatePicker fx:id="filterDate" maxWidth="Infinity" prefHeight="45.0" promptText="Sélectionner une date" style="-fx-background-radius: 8;" />
                                </VBox>
                                <VBox alignment="BOTTOM_CENTER" prefHeight="70.0">
                                    <children>
                                        <Button onAction="#reinitialiserFiltres" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #EDF2F7; -fx-text-fill: #4A5568; -fx-font-weight: bold;" text="🔄 Réinitialiser" />
                                    </children>
                                </VBox>
                                <VBox alignment="BOTTOM_CENTER" prefHeight="70.0">
                                    <children>
                                        <Button onAction="#allerAjouterPrescription" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #FF5C5C;" styleClass="btn-primary" text="➕ Ajouter Prescription" />
                                    </children>
                                </VBox>
                                <VBox alignment="BOTTOM_CENTER" prefHeight="70.0">
                                    <children>
                                        <Button onAction="#exporterPDF" prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #2D3748;" styleClass="btn-primary" text="📄 Exporter PDF" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2D3748; -fx-font-size: 16;" text="Liste des prescriptions" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- Pagination Control -->
                <Pagination fx:id="pagination" maxPageIndicatorCount="10" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;" />
            </children>
        </VBox>
    </center>
</BorderPane>

