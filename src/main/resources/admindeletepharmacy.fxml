<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/20.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminDeletePharmacyController">

    <children>

        <VBox layoutX="0.0" layoutY="0.0"
              prefHeight="720.0" prefWidth="260.0"
              styleClass="admin-sidebar">

            <padding>
                <Insets top="45" right="20" bottom="20" left="28"/>
            </padding>

            <children>
                <Label text="💊 SHIFAA ADMIN" styleClass="admin-logo"/>

                <Button text=" Retour pharmacies"
                        styleClass="admin-menu-button"
                        onAction="#goBack"/>
            </children>
        </VBox>

        <VBox layoutX="330.0" layoutY="90.0"
              spacing="22.0"
              prefWidth="650.0">

            <children>
                <Label text="Supprimer une Pharmacie"
                       styleClass="admin-page-title"/>

                <Label text="Entrer l'ID de la pharmacie à supprimer :"
                       styleClass="admin-subtitle"/>

                <TextField fx:id="pharmacyIdField"
                           promptText="ID Pharmacie"/>

                <Button text="Supprimer"
                        styleClass="red-large-button"
                        onAction="#deletePharmacy"/>

                <Button text=" Retour"
                        styleClass="dark-button"
                        onAction="#goBack"/>

                <Label fx:id="messageLabel"
                       styleClass="admin-subtitle"/>
            </children>
        </VBox>

    </children>
</AnchorPane>