<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controler.Suppparticipant" stylesheets="@shifaa.css">
    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-logo-area">
                <Label text="SHIFAA" styleClass="logo-title"/>
                <Label text="Gestion Santé" styleClass="logo-subtitle"/>
            </VBox>
            <HBox styleClass="sidebar-profile" spacing="10">
                <Label text="SG" styleClass="profile-avatar"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Saif Gharbi" styleClass="profile-name"/>
                    <Label text="Administrateur" styleClass="profile-role"/>
                </VBox>
            </HBox>
            <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="nav-section-label"/>
                <Button text="Utilisateurs" styleClass="nav-item" maxWidth="Infinity"/>
                <Button text="Événements" styleClass="nav-item" maxWidth="Infinity"/>
                <Button text="Participants" styleClass="nav-item, nav-item-active" maxWidth="Infinity"/>
                <Button text="Dossiers Médicaux" styleClass="nav-item" maxWidth="Infinity"/>
                <Button text="Réclamations" styleClass="nav-item" maxWidth="Infinity"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Separator styleClass="nav-divider"/>
                <Button text="Déconnexion" styleClass="nav-logout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #f0f4f0;">
            <!-- Header -->
            <HBox styleClass="page-header" alignment="CENTER_LEFT">
                <HBox spacing="15" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="page-title-icon" style="-fx-background-color: #ffe4d4;">
                        <Label text="🗑️" style="-fx-text-fill: #7a2c10; -fx-font-size: 20px;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Supprimer un participant" styleClass="page-title"/>
                        <Label text="Sélectionnez un participant à supprimer" styleClass="page-subtitle"/>
                    </VBox>
                </HBox>
                <Button text="Retour à la liste" styleClass="btn, btn-outline" onAction="#handleRetour"/>
            </HBox>

            <VBox style="-fx-padding: 28 28 28 28;" VBox.vgrow="ALWAYS" spacing="15">
                <Label fx:id="lblMessage" text="" style="-fx-font-weight: bold;"/>
                
                <TableView fx:id="tableView" styleClass="shifaa-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="150"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="150"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                        <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="150"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Supprimer la sélection" styleClass="btn, btn-danger, btn-lg" onAction="#handleSupprimer"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
