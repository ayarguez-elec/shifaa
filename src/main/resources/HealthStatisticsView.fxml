<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.HealthStatisticsController">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
            
            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Mon Tableau de Bord Santé" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    <Label text="Analyse en temps réel de vos données médicales" textFill="#64748B" />
                </VBox>
                <Pane HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- SUMMARY TILES -->
            <HBox spacing="20">
                <VBox prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Total Interactions" textFill="#64748B" style="-fx-font-size: 13;" />
                    <Label fx:id="totalLogsLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #3B82F6;" />
                </VBox>
                <VBox prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Intensité Moyenne" textFill="#64748B" style="-fx-font-size: 13;" />
                    <Label fx:id="avgSeverityLabel" text="0.0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #EF4444;" />
                </VBox>
                <VBox prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Dernière Activité" textFill="#64748B" style="-fx-font-size: 13;" />
                    <Label fx:id="lastActivityLabel" text="---" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #10B981;" />
                </VBox>
                <VBox prefWidth="250" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Urgences Vitales" textFill="#64748B" style="-fx-font-size: 13;" />
                    <Label fx:id="alertsCountLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #EF4444;" />
                </VBox>
            </HBox>

            <!-- CHARTS SECTION -->
            <HBox spacing="20" VBox.vgrow="ALWAYS" maxHeight="350">
                <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);" HBox.hgrow="ALWAYS">
                    <Label text="ÉVOLUTION DES SYMPTÔMES" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" />
                    <LineChart fx:id="severityChart" createSymbols="true" legendVisible="false">
                        <xAxis><CategoryAxis tickLabelFill="#64748B"/></xAxis>
                        <yAxis><NumberAxis autoRanging="false" lowerBound="0" upperBound="10" tickUnit="2" tickLabelFill="#64748B"/></yAxis>
                    </LineChart>
                </VBox>
                <VBox maxWidth="350" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                    <Label text="REPARTITION PAR TYPE" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" />
                    <PieChart fx:id="typePieChart" legendVisible="true" labelLineLength="10" />
                </VBox>
            </HBox>

            <!-- MODERN LIST SECTION -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="HISTORIQUE RÉCENT" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;" />
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="historyContainer" spacing="12">
                        <!-- Cards will be injected here -->
                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
