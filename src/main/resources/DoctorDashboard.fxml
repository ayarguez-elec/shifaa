<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.DoctorDashboardController">
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
         <content>
            <VBox spacing="30.0" style="-fx-padding: 40;">
               <children>
                  <!-- ══════════════ HERO BANNER ══════════════ -->
                  <HBox style="-fx-background-color: linear-gradient(to right, #2D3748, #4A5568); 
                               -fx-background-radius: 20; -fx-padding: 35 45; 
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0, 0, 10);" 
                        alignment="CENTER_LEFT" spacing="20">
                     <children>
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblDate" text="Mardi, 12 Mai 2026" 
                                     style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.8); 
                                            -fx-background-color: rgba(255,255,255,0.15); 
                                            -fx-background-radius: 20; -fx-padding: 5 15;" />
                              <Label fx:id="lblWelcome" text="Bonjour, Dr. Gharbi ! 👋" 
                                     style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: white;" />
                              <Label text="Prêt pour vos consultations ? Voici votre programme pour aujourd'hui." 
                                     style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.9);" />
                           </children>
                        </VBox>
                        <StackPane prefWidth="120" prefHeight="120">
                           <children>
                              <Circle radius="55" style="-fx-fill: linear-gradient(to bottom right, #2D3748, #4A5568); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);" />
                              <StackPane>
                                 <children>
                                    <!-- Shield shape using a Label with a special character or drawing it -->
                                    <Label text="🛡️" style="-fx-font-size: 60; -fx-text-fill: rgba(255,255,255,0.2);" />
                                    <VBox alignment="CENTER" spacing="0">
                                       <children>
                                          <StackPane>
                                             <children>
                                                <Region style="-fx-background-color: white; -fx-min-width: 30; -fx-min-height: 8; -fx-max-width: 30; -fx-max-height: 8;" />
                                                <Region style="-fx-background-color: white; -fx-min-width: 8; -fx-min-height: 30; -fx-max-width: 8; -fx-max-height: 30;" />
                                             </children>
                                          </StackPane>
                                       </children>
                                    </VBox>
                                 </children>
                              </StackPane>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>

                  <!-- 1. Cartes de résumé -->
                  <GridPane hgap="20.0" vgap="20.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="120.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" GridPane.columnIndex="0">
                           <children>
                              <Label text="RDV AUJOURD'HUI" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #718096;" />
                              <Label fx:id="lblTodayRDV" text="8" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #4A6CF7;" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" GridPane.columnIndex="1">
                           <children>
                              <Label text="MES PATIENTS" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #718096;" />
                              <Label fx:id="lblNewPatients" text="12" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #48BB78;" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="5" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" GridPane.columnIndex="2">
                           <children>
                              <Label text="NOTE MOYENNE" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #718096;" />
                              <Label fx:id="lblRating" text="4.9/5" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #ECC94B;" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <HBox spacing="30.0">
                     <children>
                        <!-- 2. Agenda du jour (LISTE DE CARTES) -->
                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="🕒 Agenda des Consultations" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                              
                              <VBox fx:id="vboxAgenda" spacing="12">
                                 <!-- Les cartes de RDV seront injectées ici -->
                                 <children>
                                    <Label text="Aucune consultation prévue pour le moment." style="-fx-text-fill: #A0AEC0;" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <!-- 3. Actions Rapides -->
                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" prefWidth="280">
                           <children>
                              <Label text="⚡ Raccourcis" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                              <VBox spacing="15">
                                 <children>
                                    <Button onAction="#goToAddPatient" maxWidth="Infinity" style="-fx-background-color: #EBF8FF; -fx-text-fill: #2B6CB0; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 15; -fx-background-radius: 10;" text="👥 Mes Patients" />
                                    <Button onAction="#goToAddFile" maxWidth="Infinity" style="-fx-background-color: #F0FFF4; -fx-text-fill: #276749; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 15; -fx-background-radius: 10;" text="📁 Créer Dossier" />
                                    <Button onAction="#goToAddPrescription" maxWidth="Infinity" style="-fx-background-color: #FFF5F5; -fx-text-fill: #C53030; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 15; -fx-background-radius: 10;" text="💊 Nouvelle Ordonnance" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        
                        <!-- 4. CALENDRIER (Admin Style) -->
                        <VBox spacing="0" prefWidth="380" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4);">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #4A6CF7; -fx-background-radius: 16 16 0 0; -fx-padding: 15;">
                                 <children>
                                    <Label text="MON CALENDRIER" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox alignment="CENTER" spacing="5">
                                       <children>
                                          <Button onAction="#prevWeek" text="◀" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" />
                                          <Label fx:id="monthYearLabel" text="Mai 2026" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: white;" />
                                          <Button onAction="#nextWeek" text="▶" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                              <HBox fx:id="weekRow" alignment="CENTER" spacing="0" style="-fx-background-color: #EEF2FF; -fx-padding: 10;" />
                              <VBox spacing="10" style="-fx-padding: 15;">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                       <children>
                                          <Label fx:id="selectedDateLabel" text="Aujourd'hui" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #4A5568;" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button onAction="#openAddEventForm" text="+ Ajouter" style="-fx-background-color: #4A6CF7; -fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 3 8;" />
                                       </children>
                                    </HBox>

                                    <!-- Formulaire d'ajout (caché par défaut) -->
                                    <VBox fx:id="addEventForm" spacing="8" managed="false" visible="false" style="-fx-background-color: #F8FAFF; -fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #C7D2FE; -fx-border-radius: 10;">
                                       <children>
                                          <TextField fx:id="eventTitleField" promptText="Titre de l'événement" style="-fx-font-size: 11;" />
                                          <HBox spacing="5">
                                             <children>
                                                <TextField fx:id="eventTimeField" promptText="HH:mm" prefWidth="60" style="-fx-font-size: 11;" />
                                                <ComboBox fx:id="eventTypeCombo" promptText="Type" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-size: 11;" />
                                             </children>
                                          </HBox>
                                          <TextArea fx:id="eventDescField" promptText="Description" prefRowCount="2" style="-fx-font-size: 11;" />
                                          <HBox spacing="5" alignment="CENTER_RIGHT">
                                             <children>
                                                <Button onAction="#cancelAddEvent" text="Annuler" style="-fx-font-size: 10;" />
                                                <Button onAction="#confirmAddEvent" text="Enregistrer" style="-fx-background-color: #4A6CF7; -fx-text-fill: white; -fx-font-size: 10; -fx-font-weight: bold;" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>

                                    <VBox fx:id="calendarEventsContainer" spacing="5" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
