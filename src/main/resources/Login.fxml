<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="Controler.LoginController" stylesheets="@shifaa.css" styleClass="auth-root" prefWidth="900" prefHeight="600">
    
    <!-- Left Pane (Dark with Logo) -->
    <VBox styleClass="auth-left-pane" HBox.hgrow="ALWAYS" spacing="20" maxWidth="450" alignment="CENTER">
        <ImageView fitWidth="180" preserveRatio="true" styleClass="auth-logo">
            <image>
                <Image url="@images/logo.png"/>
            </image>
        </ImageView>
        <Label text="SHIFAA" styleClass="auth-title" style="-fx-text-fill: #ffffff;"/>
        <Label text="Connexion" style="-fx-font-size: 18px; -fx-text-fill: rgba(255,255,255,0.7);"/>
    </VBox>

    <!-- Right Pane (White with Form) -->
    <VBox styleClass="auth-right-pane" HBox.hgrow="ALWAYS" alignment="CENTER">
        <VBox maxWidth="350" spacing="30" alignment="CENTER">
            
            <VBox alignment="CENTER" spacing="10">
                <Label text="Bienvenue !" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
                <Label text="Connectez-vous pour continuer" style="-fx-text-fill: #718096;"/>
            </VBox>

            <VBox spacing="15">
                <TextField fx:id="tfEmail" promptText="Email" styleClass="form-field"/>
                <PasswordField fx:id="tfPassword" promptText="Mot de passe" styleClass="form-field"/>
            </VBox>

            <VBox spacing="10" alignment="CENTER">
                <Button text="SE CONNECTER" onAction="#handleLogin" maxWidth="Infinity" styleClass="btn, btn-primary, btn-lg" style="-fx-background-color: #f86060; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Pas encore de compte ?" style="-fx-text-fill: #718096;"/>
                    <Hyperlink text="S'inscrire" onAction="#handleGoToSignUp" style="-fx-text-fill: #f86060; -fx-font-weight: bold;"/>
                </HBox>
                <Label fx:id="lblMessage" text="" style="-fx-font-weight: bold;"/>
            </VBox>

        </VBox>
    </VBox>
</HBox>
