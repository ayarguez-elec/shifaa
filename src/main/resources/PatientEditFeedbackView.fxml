<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="950.0" prefHeight="700.0" styleClass="root" stylesheets="@theme-medical.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controler.PatientEditFeedbackController">

    <VBox spacing="20" style="-fx-padding: 30;" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Bouton Retour -->
        <Button onAction="#goBack" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand; -fx-max-width: 100;" text="← Retour" />

        <!-- Titre -->
        <Label fx:id="titleLabel" style="-fx-font-size: 22; -fx-font-weight: bold;" text="Modifier le feedback" textFill="#2d3748" />

        <!-- Note avec étoiles -->
        <Label text="Note :" style="-fx-font-size: 14; -fx-font-weight: bold;" textFill="#2d3748" />
        <HBox fx:id="starsBox" spacing="5" alignment="CENTER_LEFT" />

        <!-- Commentaire -->
        <Label text="Commentaire :" style="-fx-font-size: 14; -fx-font-weight: bold;" textFill="#2d3748" />
        <TextArea fx:id="commentArea" prefHeight="150" wrapText="true" promptText="Votre expérience avec ce professionnel..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 10;" />

        <!-- Option anonyme -->
        <CheckBox fx:id="anonymeCheck" text="Afficher anonymement" style="-fx-font-size: 14;" />

        <!-- Bouton Mettre à jour -->
        <Button onAction="#updateFeedback" style="-fx-background-color: #FF5C5C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;" text="💾 Mettre à jour" />

    </VBox>
</AnchorPane>
