<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="800.0" prefWidth="1400.0"
            styleClass="root" stylesheets="@theme-medical.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controler.AssistantMainController">
    <left>
        <!-- Sidebar uses BorderPane so logout is always anchored to bottom -->
        <BorderPane prefWidth="260.0"
                    style="-fx-background-color: linear-gradient(to bottom, #1A202C, #2D3748);">

            <!-- ── TOP: brand + avatar ── -->
            <top>
                <VBox>
                    <!-- Brand header -->
                    <HBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-padding: 22 18 18 18; -fx-background-color: rgba(0,0,0,0.2);">
                        <ImageView fx:id="logoView" fitHeight="32" fitWidth="32" />
                        <VBox spacing="1">
                            <Label text="SHIFAA"
                                   style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;" />
                            <Label text="Espace Assistant"
                                   style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10;" />
                        </VBox>
                    </HBox>
                    <!-- Avatar + name -->
                    <VBox alignment="CENTER" spacing="8"
                          style="-fx-padding: 16 18 16 18;
                                 -fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: transparent transparent rgba(255,255,255,0.08) transparent;
                                 -fx-border-width: 0 0 1 0;">
                        <StackPane prefWidth="68" prefHeight="68">
                            <Circle fx:id="avatarCircle" radius="34" style="-fx-fill: #4A6CF7;" />
                            <Label fx:id="initialsLabel" text="?"
                                   style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" />
                            <ImageView fx:id="profileImageView" fitHeight="68" fitWidth="68"
                                       style="-fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),8,0,0,2);">
                                <clip><Circle radius="34" centerX="34" centerY="34" /></clip>
                            </ImageView>
                        </StackPane>
                        <Label fx:id="userNameLabel" text="Assistant"
                               style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;" />
                        <Label text="Assistant Médical"
                               style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 10;" />
                    </VBox>
                </VBox>
            </top>

            <!-- ── CENTER: nav buttons ── -->
            <center>
                <VBox spacing="2" style="-fx-padding: 10 10 0 10;">
                    <Label text="GÉNÉRAL" styleClass="sidebar-category" />
                    <Button onAction="#goToDashboard"    text="🏠  Tableau de bord"    styleClass="sidebar-nav-btn-active" />

                    <Label text="GESTION PATIENTS" styleClass="sidebar-category" />
                    <Button onAction="#goToPatients"     text="👥  Patients du Docteur" styleClass="sidebar-nav-btn" />

                    <Label text="AGENDA" styleClass="sidebar-category" />
                    <Button onAction="#goToAppointments" text="📅  Rendez-vous"         styleClass="sidebar-nav-btn" />
                    <Button onAction="#goToAvailability" text="🕒  Disponibilités"       styleClass="sidebar-nav-btn" />

                    <Label text="COMPTE" styleClass="sidebar-category" />
                    <Button onAction="#goToProfile"      text="👤  Mon Profil"           styleClass="sidebar-nav-btn" />
                </VBox>
            </center>

            <!-- ── BOTTOM: logout always visible ── -->
            <bottom>
                <VBox style="-fx-padding: 10 10 16 10;
                             -fx-border-color: rgba(255,255,255,0.08) transparent transparent transparent;
                             -fx-border-width: 1 0 0 0;">
                    <Button onAction="#logout" text="🚪  Déconnexion"
                            styleClass="sidebar-logout-btn" />
                </VBox>
            </bottom>

        </BorderPane>
    </left>
    <center>
        <AnchorPane fx:id="contentContainer" prefHeight="800.0" prefWidth="1150.0"
                    style="-fx-background-color: #F7FAFC;" />
    </center>
</BorderPane>
