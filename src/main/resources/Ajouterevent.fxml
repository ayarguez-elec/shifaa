<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controler.Ajouterevent" stylesheets="@shifaa.css" prefWidth="1100" prefHeight="720">
    <center>
        <VBox style="-fx-background-color: #f0f4f0;">
            <!-- Header -->
            <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
                <StackPane styleClass="page-title-icon">
                    <Label text="➕" style="-fx-font-size: 20px;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Ajouter un événement" styleClass="page-title"/>
                    <Label text="Remplissez le formulaire ci-dessous" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Retour à la liste" styleClass="btn, btn-outline" onAction="#handleVoirListe"/>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0 28 28 28;" VBox.vgrow="ALWAYS">
                <VBox alignment="TOP_CENTER">
                    <VBox styleClass="form-card" spacing="15" maxWidth="700">
                        
                        <VBox spacing="5">
                            <Label text="TITRE *" styleClass="form-label"/>
                            <TextField fx:id="tfTitre" promptText="Titre de l'événement" styleClass="form-field"/>
                        </VBox>

                        <HBox spacing="14">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="TYPE *" styleClass="form-label"/>
                                <ComboBox fx:id="cbType" maxWidth="Infinity" styleClass="form-combo"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="STATUT" styleClass="form-label"/>
                                <ComboBox fx:id="cbStatus" maxWidth="Infinity" styleClass="form-combo"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="DATE *" styleClass="form-label"/>
                                <DatePicker fx:id="dpDate" maxWidth="Infinity" styleClass="date-picker"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="HEURE" styleClass="form-label"/>
                                <TextField fx:id="tfTime" promptText="09:00" styleClass="form-field"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="LIEU *" styleClass="form-label"/>
                                <TextField fx:id="tfLieu" promptText="Ex: Hôpital La Rabta, Tunis" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="CAPACITÉ MAX" styleClass="form-label"/>
                                <TextField fx:id="tfCapacite" promptText="50" styleClass="form-field"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label text="DESCRIPTION" styleClass="form-label"/>
                            <TextArea fx:id="taDescription" promptText="Description..." prefRowCount="3" styleClass="form-textarea"/>
                        </VBox>

                        <Label fx:id="lblMessage" text="" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

                        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                            <Button text="Réinitialiser" styleClass="btn, btn-outline" onAction="#handleReset"/>
                            <Button text="Ajouter l'événement" styleClass="btn, btn-primary" onAction="#handleAjouter"/>
                        </HBox>
                        
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
