<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="900.0" prefWidth="1150.0"
            style="-fx-background-color: #F0F4F8;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controler.AssistantDashboardController">

    <ScrollPane fitToWidth="true"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="22" style="-fx-padding: 28;">

            <!-- ══════════════ HERO BANNER ══════════════ -->
            <HBox style="-fx-background-color: linear-gradient(to right, #4A6CF7, #2B4FD4);
                         -fx-background-radius: 20; -fx-padding: 28 40;
                         -fx-effect: dropshadow(gaussian, rgba(74,108,247,0.35), 20, 0, 0, 8);"
                  alignment="CENTER_LEFT" spacing="0">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label fx:id="dateLabel" text="Jeudi, 14 Mai 2026"
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.75);
                                  -fx-background-color: rgba(255,255,255,0.15);
                                  -fx-background-radius: 20; -fx-padding: 4 12;" />
                    <Label fx:id="greetingLabel" text="Bonjour, Assistant ! 👋"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="Voici un résumé de l'activité du cabinet aujourd'hui."
                           style="-fx-font-size: 12; -fx-text-fill: rgba(255,255,255,0.80);" />
                    <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
                        <Button onAction="#goToPatients" text="👥 Voir les patients"
                                style="-fx-background-color: white; -fx-text-fill: #4A6CF7;
                                       -fx-font-weight: bold; -fx-background-radius: 10;
                                       -fx-padding: 7 16; -fx-cursor: hand; -fx-font-size: 12;" />
                        <Button onAction="#goToAppointments" text="📅 Gérer les rendez-vous"
                                style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 10;
                                       -fx-padding: 7 16; -fx-cursor: hand; -fx-font-size: 12;
                                       -fx-border-color: rgba(255,255,255,0.5); -fx-border-radius: 10;" />
                    </HBox>
                </VBox>
                <StackPane prefWidth="180" prefHeight="110" alignment="CENTER">
                    <Label text="🩺" style="-fx-font-size: 80; -fx-opacity: 0.20;" />
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="ASSISTANT"
                               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white; -fx-opacity: 0.9;" />
                        <Label text="Tableau de bord"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.65);" />
                    </VBox>
                </StackPane>
            </HBox>

            <!-- ══════════════ KPI CARDS (3 cards) ══════════════ -->
            <HBox spacing="15">

                <!-- Total Patients -->
                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #90CDF4; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #EBF8FF; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="👥" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="PATIENTS"
                                   style="-fx-font-size: 9; -fx-text-fill: #2B6CB0; -fx-font-weight: bold;" />
                            <Label fx:id="totalPatientsLabel" text="0"
                                   style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #2B6CB0;" />
                        </VBox>
                    </HBox>
                    <Label text="Patients du médecin"
                           style="-fx-font-size: 10; -fx-text-fill: #718096;" />
                </VBox>

                <!-- Today's Appointments -->
                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #68D391; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #F0FFF4; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="📅" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="AUJOURD'HUI"
                                   style="-fx-font-size: 9; -fx-text-fill: #276749; -fx-font-weight: bold;" />
                            <Label fx:id="todayApptsLabel" text="0"
                                   style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #276749;" />
                        </VBox>
                    </HBox>
                    <Label text="Rendez-vous du jour"
                           style="-fx-font-size: 10; -fx-text-fill: #276749;" />
                </VBox>

                <!-- Pending -->
                <VBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #F6AD55; -fx-border-width: 0 0 0 4; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 3); -fx-padding: 18;"
                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane style="-fx-background-color: #FFFAF0; -fx-background-radius: 10; -fx-padding: 9;">
                            <Label text="⏳" style="-fx-font-size: 18;" />
                        </StackPane>
                        <VBox spacing="1">
                            <Label text="EN ATTENTE"
                                   style="-fx-font-size: 9; -fx-text-fill: #C05621; -fx-font-weight: bold;" />
                            <Label fx:id="pendingApptsLabel" text="0"
                                   style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #C05621;" />
                        </VBox>
                    </HBox>
                    <Label text="À confirmer / refuser"
                           style="-fx-font-size: 10; -fx-text-fill: #C05621;" />
                </VBox>

            </HBox>

            <!-- ══════════════ ROW 2: Pending only (full width) ══════════════ -->
            <VBox spacing="13"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4); -fx-padding: 22;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="⏳ Rendez-vous en attente"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #2D3748;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#goToAppointments" text="Voir tout →"
                            style="-fx-background-color: transparent; -fx-text-fill: #4A6CF7;
                                   -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 12;" />
                </HBox>
                <Separator />
                <ScrollPane fitToWidth="true" prefHeight="260" maxHeight="260"
                            style="-fx-background-color: transparent; -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="pendingContainer" spacing="8">
                        <Label text="Chargement..."
                               style="-fx-text-fill: #A0AEC0; -fx-font-size: 13;" />
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ══════════════ ROW 3: CALENDAR ══════════════ -->
            <VBox spacing="0" prefWidth="1.7976931348623157E308"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4);">

                <!-- Blue header -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: #4A6CF7;
                             -fx-background-radius: 16 16 0 0; -fx-padding: 18 20;">
                    <Label text="MON CALENDRIER"
                           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"
                           HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="6"
                          style="-fx-background-color: rgba(255,255,255,0.20);
                                 -fx-background-radius: 8; -fx-padding: 5 10;">
                        <Button onAction="#prevWeek" text="◀"
                                style="-fx-background-color: transparent; -fx-text-fill: white;
                                       -fx-cursor: hand; -fx-padding: 0 4; -fx-font-size: 10;" />
                        <Label fx:id="monthYearLabel" text="MAI 2026"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: white;" />
                        <Button onAction="#nextWeek" text="▶"
                                style="-fx-background-color: transparent; -fx-text-fill: white;
                                       -fx-cursor: hand; -fx-padding: 0 4; -fx-font-size: 10;" />
                    </HBox>
                </HBox>

                <!-- Week row -->
                <HBox fx:id="weekRow" alignment="CENTER" spacing="0"
                      style="-fx-background-color: #EEF2FF; -fx-padding: 14 16;" />

                <!-- Events section -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 0 0 16 16;
                             -fx-padding: 16 20 20 20;">

                    <!-- Date title + Add button -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 10 0;">
                        <Label fx:id="selectedDateLabel" text="MAI, 14"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #4A5568;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#openAddEventForm" text="+ Ajouter"
                                style="-fx-background-color: #4A6CF7; -fx-text-fill: white;
                                       -fx-font-size: 11; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-padding: 4 12; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Add event form (hidden by default) -->
                    <VBox fx:id="addEventForm" spacing="8" managed="false" visible="false"
                          style="-fx-background-color: #F8FAFF; -fx-background-radius: 12;
                                 -fx-border-color: #C7D2FE; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14;">
                        <TextField fx:id="eventTitleField" promptText="Titre de l'événement"
                                   style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                          -fx-border-radius: 8; -fx-background-radius: 8;
                                          -fx-padding: 7 10; -fx-font-size: 12;" />
                        <HBox spacing="8">
                            <TextField fx:id="eventTimeField" promptText="HH:mm" prefWidth="80"
                                       style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-padding: 7 10; -fx-font-size: 12;" />
                            <ComboBox fx:id="eventTypeCombo" promptText="Type"
                                      HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                      style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 12;" />
                        </HBox>
                        <TextArea fx:id="eventDescField" promptText="Description (optionnel)"
                                  prefRowCount="2"
                                  style="-fx-background-color: white; -fx-border-color: #C7D2FE;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-padding: 7 10; -fx-font-size: 12;" />
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Button onAction="#cancelAddEvent" text="Annuler"
                                    style="-fx-background-color: #E2E8F0; -fx-text-fill: #4A5568;
                                           -fx-font-size: 11; -fx-background-radius: 8;
                                           -fx-padding: 6 14; -fx-cursor: hand;" />
                            <Button onAction="#confirmAddEvent" text="✓ Enregistrer"
                                    style="-fx-background-color: #4A6CF7; -fx-text-fill: white;
                                           -fx-font-size: 11; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <!-- Events list -->
                    <ScrollPane fitToWidth="true" prefHeight="200" maxHeight="200"
                                style="-fx-background-color: transparent; -fx-background: transparent;
                                       -fx-border-color: transparent;">
                        <VBox fx:id="eventsContainer" spacing="0" />
                    </ScrollPane>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</AnchorPane>
