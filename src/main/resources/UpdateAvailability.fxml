<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            styleClass="root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controler.UpdateAvailability">
    <children>
        <!-- Sidebar -->
        <AnchorPane prefHeight="650.0" prefWidth="220.0" styleClass="sidebar">
            <children>
                <Label layoutX="30.0" layoutY="40.0" text="SHIFAA" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Button layoutY="120.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button" text="Tableau de bord"/>
                <Button layoutY="170.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button" text="Rendez-vous"/>
                <Button layoutY="220.0" prefHeight="50.0" prefWidth="220.0" styleClass="menu-button-active" text="Disponibilités"/>
            </children>
        </AnchorPane>

        <Label layoutX="260.0" layoutY="30.0"
               style="-fx-font-size: 22; -fx-font-weight: bold;"
               text="Modification d'une Disponibilité" textFill="#2d3748"/>

        <!-- Search -->
        <Label layoutX="260.0" layoutY="85.0" text="Rechercher par ID disponibilité :"/>
        <TextField fx:id="searchId" layoutX="260.0" layoutY="105.0" prefWidth="200.0" promptText="ID"/>
        <Button layoutX="475.0" layoutY="105.0"
                prefHeight="30.0" prefWidth="110.0"
                styleClass="btn-primary" text="Rechercher"
                onAction="#rechercherDisponibilite"/>

        <!-- Médecin -->
        <Label layoutX="260.0" layoutY="158.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Médecin"/>
        <Label layoutX="260.0" layoutY="184.0" text="ID Médecin :"/>
        <TextField fx:id="doctorId" layoutX="260.0" layoutY="203.0" prefWidth="200.0"/>

        <!-- Créneau -->
        <Label layoutX="260.0" layoutY="255.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Créneau"/>

        <Label layoutX="260.0" layoutY="281.0" text="Date :"/>
        <DatePicker fx:id="date" layoutX="260.0" layoutY="300.0" prefWidth="200.0"/>

        <Label layoutX="490.0" layoutY="281.0" text="Heure :"/>
        <TextField fx:id="time" layoutX="490.0" layoutY="300.0"
                   prefWidth="200.0" promptText="HH:mm:ss"/>

        <!-- Statut -->
        <Label layoutX="260.0" layoutY="355.0"
               style="-fx-font-weight: bold; -fx-text-fill: #FF5C5C;" text="Statut"/>
        <Label layoutX="260.0" layoutY="381.0" text="statusRDV :"/>
        <ComboBox fx:id="statusRDV" layoutX="260.0" layoutY="400.0" prefWidth="200.0"/>

        <Label fx:id="messageLabel" layoutX="260.0" layoutY="470.0"
               style="-fx-text-fill: #38A169;"/>

        <Button layoutX="700.0" layoutY="590.0"
                prefHeight="40.0" prefWidth="140.0"
                styleClass="btn-primary" text="Modifier"
                onAction="#modifierDisponibilite"/>
    </children>
</AnchorPane>
